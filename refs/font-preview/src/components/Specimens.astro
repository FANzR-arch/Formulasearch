---
// Keep production class names and real content, without its site scripts, footer, or contact dialogs.
import LocalizedText from '../../../../src/components/LocalizedText.astro'
import ProjectCard from './ProjectCard.astro'
import { homeContent } from '../../../../src/lib/home-content'
import { catalogPages, projectItems } from '../../../../src/data/catalog'
import { siteConfig } from '../../../../src/data/site-config'
import type { Locale } from '../../../../src/lib/i18n'
import { articleHtml, articleMetadata, sources } from './samples'

interface Props {
  locale?: Locale
}
const { locale = 'zh' } = Astro.props
const projectsPage = catalogPages.projects
const projectIds = ['seedo', 'rzframe', 'briank']
const projects = projectIds.map((id) => {
  const item = projectItems.find((project) => project.id === id)
  if (!item) throw new Error(`Font preview: real project "${id}" is missing.`)
  return item
})
const projectHref = (id: string) => new URL(`${locale === 'en' ? '/en' : ''}/projects/${id}`, siteConfig.siteUrl).toString()
---

<div class="fp-specimens">
  <section id="specimen-home" class="fp-specimen" aria-labelledby="specimen-home-label" data-specimen-source={sources.home.path}>
    <h2 id="specimen-home-label" class="fp-specimen__label"><LocalizedText zh="首页" en="Homepage" /></h2>
    <section class="intro" aria-labelledby="specimen-home-title">
      <h1 id="specimen-home-title"><LocalizedText zh={homeContent.zh.name} en={homeContent.en.name} /></h1>
      <p class="lead"><LocalizedText zh={homeContent.zh.intro.join(' ')} en={homeContent.en.intro.join(' ')} /></p>
      <div class="home-copy">
        {homeContent.zh.about.map((text, index) => <p><LocalizedText zh={text} en={homeContent.en.about[index]} /></p>)}
        {homeContent.zh.interest.map((text, index) => <p><LocalizedText zh={text} en={homeContent.en.interest[index]} /></p>)}
      </div>
    </section>
  </section>

  <section id="specimen-projects" class="fp-specimen" aria-labelledby="specimen-projects-label" data-specimen-source={sources.projects.path}>
    <h2 id="specimen-projects-label" class="fp-specimen__label"><LocalizedText zh="项目页" en="Projects page" /></h2>
    <header class="page-hero">
      <h1><LocalizedText {...projectsPage.heading} /></h1>
      {projectsPage.intro && <p class="page-hero__description"><LocalizedText {...projectsPage.intro} /></p>}
    </header>
    <div class="project-card-grid">
      {projects.map((item, index) => <ProjectCard item={item} href={projectHref(item.id)} locale={locale} eager={index === 0} />)}
    </div>
  </section>

  <section id="specimen-article" class="fp-specimen" aria-labelledby="specimen-article-label" data-specimen-source={sources.article.path}>
    <h2 id="specimen-article-label" class="fp-specimen__label"><LocalizedText zh="博客正文" en="Blog article" /></h2>
    <article class="article-page">
      <header class="article-header">
        <p class="article-meta"><time datetime={articleMetadata.date}>{articleMetadata.date.replaceAll('-', '.')}</time></p>
        <h1><LocalizedText {...articleMetadata.title} /></h1>
        <p><LocalizedText {...articleMetadata.description} /></p>
      </header>
      <!-- Both excerpts are real source text. Preview-only Markdown roles are documented in samples.ts. -->
      <div class="article-prose localized-text__zh" data-specimen-locale="zh" lang="zh-Hans" set:html={articleHtml.zh} />
      <div class="article-prose localized-text__en" data-specimen-locale="en" lang="en" set:html={articleHtml.en} />
    </article>
  </section>
</div>
