# Dependencies
node_modules/

# Astro and production output
.astro/
dist/

# Local environment files
.env
.env.*
!.env.example

# Logs and editor files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tooling
.codex/
.agents/
output/

# Local memory state accidentally created by tooling
$HOME/

# Playwright reports and per-test artifacts
/playwright-report/
/test-results/
/blob-report/

# Local source photography; generated/public WebP files are tracked separately.
# Keep the policy README visible while leaving original binaries out of Git.
/src/assets/archive/photos/*.jpg
/src/assets/archive/photos/*.jpeg
/src/assets/archive/photos/*.png
!/src/assets/archive/photos/README.md
