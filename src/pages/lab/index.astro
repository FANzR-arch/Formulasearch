---
import CatalogLayout from '../../layouts/CatalogLayout.astro'
import CatalogIndex from '../../components/CatalogIndex.astro'
import { catalogPages, labSections as sections } from '../../data/catalog'
const page = catalogPages.lab
---

<CatalogLayout active="lab" title={page.title} description={page.description}>
  <CatalogIndex page={page} sections={sections} motionVariant="lab" />
</CatalogLayout>
