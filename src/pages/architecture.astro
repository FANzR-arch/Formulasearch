---
import ArchiveIndex from '../components/ArchiveIndex.astro'
import CatalogLayout from '../layouts/CatalogLayout.astro'
import { architectureItems, architecturePage } from '../data/architecture'
---

<CatalogLayout active="architecture" variant="archive" title={architecturePage.pageTitle} description={architecturePage.pageDescription}>
  <ArchiveIndex
    active="architecture"
    kicker={architecturePage.kicker}
    title={architecturePage.title}
    description={architecturePage.description}
    initialVisibleCount={architecturePage.initialVisibleCount}
    loadMoreBatchSize={architecturePage.loadMoreBatchSize}
    filters={architecturePage.filters}
    items={architectureItems}
  />
</CatalogLayout>
