---
import ArchiveIndex from '../components/ArchiveIndex.astro'
import { photoArchivePage, selectedPhotoArchive } from '../data/photo-archive'
import CatalogLayout from '../layouts/CatalogLayout.astro'
---

<CatalogLayout active="photos" variant="archive" title={photoArchivePage.pageTitle} description={photoArchivePage.pageDescription}>
  <ArchiveIndex
    active="photos"
    title={photoArchivePage.title}
    description={photoArchivePage.description}
    eagerImageCount={photoArchivePage.eagerImageCount}
    initialVisibleCount={photoArchivePage.initialVisibleCount}
    autoLoadBatchSize={photoArchivePage.autoLoadBatchSize}
    filters={photoArchivePage.filters}
    items={selectedPhotoArchive}
  />
</CatalogLayout>
