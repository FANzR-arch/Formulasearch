---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { homeContent } from '../lib/home-content'
---

<BaseLayout title="Phil / Formula" description="Phil builds AI tools, visual systems, websites, and writing.">
  <div id="intro-overlay" class="intro-overlay" aria-hidden="true">
    <svg class="intro-screen" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" role="presentation">
      <defs>
        <path id="intro-logo-shape" pathLength="1" d="M363.48 29.18c19.12-.5 42.12 8.18 57.95 24.01s24.51 38.84 24 57.96c.51 19.12-8.17 42.12-24 57.96-15.83 15.84-38.83 24.52-57.95 24.02l-156.58.03c-11.39-1.15-24.29 11.75-23.14 23.14v211.01c-1.15 11.39 11.75 24.29 23.14 23.14 11.39 1.15 24.29-11.75 23.14-23.14v-152.31c-.15-5.15 3.38-10.3 8.22-12.3 4.84-2 10.98-.86 14.51 2.89l180.66 180.66c2.56 2.63 6.48 4.26 10.15 4.21h8.41c4.35.44 9.29-4.49 8.85-8.85v-111.21c.43-4.23-4.36-9.02-8.59-8.59-4.23-.43-9.02 4.36-8.59 8.59v52.77c.15 5.15-3.38 10.3-8.22 12.3-4.84 2-10.98.86-14.51-2.89l-147.59-147.59c-3.75-3.53-4.89-9.67-2.89-14.51 2-4.84 7.15-8.37 12.3-8.22l80.73-.02c25.91.68 57.07-11.08 78.53-32.55 21.46-21.46 33.21-52.63 32.53-78.54.69-25.91-11.07-57.08-32.53-78.54C420.56 11.14 389.4-.62 363.49.06L32.49 0C24.09-.07 15.6 3.47 9.59 9.48 3.57 15.5.03 23.98.1 32.39v385.67c-1.62 15.94 16.45 34 32.38 32.38 15.94 1.62 34-16.45 32.38-32.38v-181.24c-.73-7.16 7.39-15.28 14.55-14.55h60.13c7.16.73 15.28-7.39 14.55-14.55.73-7.16-7.39-15.28-14.55-14.55H79.41c-7.16.73-15.28-7.39-14.55-14.55V43.66c-.03-3.78 1.56-7.59 4.26-10.29 2.7-2.7 6.52-4.29 10.29-4.26l284.06.06" />
        <pattern id="intro-grid" width="96" height="96" patternUnits="userSpaceOnUse">
          <path d="M0 0h96M0 0v96" fill="none" stroke="currentColor" stroke-width="1" />
        </pattern>
        <mask id="intro-cutout" maskUnits="userSpaceOnUse" x="-40" y="-40" width="2000" height="1160">
          <rect x="-40" y="-40" width="2000" height="1160" fill="white" />
          <g transform="translate(829.5 416.1) scale(.55)">
            <g class="intro-mark__motion">
              <use class="intro-mark__cutout" href="#intro-logo-shape" />
            </g>
          </g>
        </mask>
      </defs>
      <g mask="url(#intro-cutout)">
        <rect class="intro-field" x="-40" y="-40" width="2000" height="1160" />
        <rect class="intro-grid" x="-40" y="-40" width="2000" height="1160" fill="url(#intro-grid)" />
      </g>
      <g class="intro-mark" transform="translate(829.5 416.1) scale(.55)">
        <g class="intro-mark__motion">
          <use class="intro-mark__line" href="#intro-logo-shape" />
        </g>
      </g>
    </svg>
  </div>

  <div id="site-page" class="site-page">
    <canvas id="ambient-flow" class="ambient-flow" aria-hidden="true"></canvas>
    <SiteHeader logoMode="background" email={homeContent.email} />

    <main id="top">
      <section class="intro" aria-labelledby="intro-title">
        <h1 id="intro-title">{homeContent.name}</h1>
        <p class="lead">{homeContent.intro.join(' ')}</p>
        <div class="home-copy">
          {homeContent.about.map((paragraph) => <p>{paragraph}</p>)}
          {homeContent.interest.map((paragraph) => <p>{paragraph}</p>)}
          <hr />
          <div class="home-contact">
            <p class="home-copy__label">在这里找到我</p>
            <p>
              <a class="text-link" href={homeContent.socialUrl} target="_blank" rel="noreferrer">{homeContent.socialLabel}</a>
              <br />
              或者给我发个邮件：<strong><a class="text-link" href={`mailto:${homeContent.email}`}>{homeContent.email}</a></strong>
            </p>
          </div>
          <hr />
          <p>{homeContent.sponsor}</p>
        </div>
        {homeContent.heroImage && <img class="hero-image" src={homeContent.heroImage} alt="Homepage photo" loading="eager" />}
      </section>
    </main>
  </div>

  <noscript><style>.site-page { opacity: 1 !important; transform: none !important; }</style></noscript>
  <script is:inline src="/scripts/liquid-background.js"></script>
  <script is:inline>
    const overlay = document.querySelector('#intro-overlay')
    const page = document.querySelector('#site-page')
    const themeToggle = document.querySelector('#theme-toggle')
    const introMotion = document.querySelector('.intro-mark .intro-mark__motion')
    const introLine = document.querySelector('.intro-mark__line')
    const storageKey = 'formulasearch-intro-seen'
    const isLocalPreview = ['127.0.0.1', 'localhost', '::1'].includes(window.location.hostname)
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let syncAmbientTheme = () => {}
    let completed = false
    let lineFrame = 0

    const updateLineWeight = () => {
      if (!introLine?.getScreenCTM) return
      const matrix = introLine.getScreenCTM()
      const scale = matrix ? Math.hypot(matrix.a, matrix.b) : 0
      if (scale) introLine.style.strokeWidth = `${1.1 / scale}px`
    }

    const trackLineWeight = () => {
      updateLineWeight()
      lineFrame = window.requestAnimationFrame(trackLineWeight)
    }

    const stopTrackingLineWeight = () => {
      if (lineFrame) window.cancelAnimationFrame(lineFrame)
      lineFrame = 0
      updateLineWeight()
    }

    updateLineWeight()

    const unveilPage = () => page?.classList.add('is-visible')

    const revealPage = () => {
      if (completed) return
      completed = true
      stopTrackingLineWeight()
      if (!isLocalPreview) {
        try { sessionStorage.setItem(storageKey, 'true') } catch {}
      }
      unveilPage()
      overlay?.classList.add('is-exiting')
      const removeOverlay = () => overlay?.remove()
      overlay?.addEventListener('transitionend', removeOverlay, { once: true })
      window.setTimeout(removeOverlay, 450)
    }

    const setTheme = (theme) => {
      document.documentElement.dataset.theme = theme
      themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'))
      themeToggle?.setAttribute('aria-label', theme === 'dark' ? '切换到浅色主题' : '切换到深色主题')
    }

    const saveTheme = (theme) => {
      setTheme(theme)
      syncAmbientTheme()
      try { localStorage.setItem('formulasearch-theme', theme) } catch {}
    }

    let savedTheme = ''
    try { savedTheme = localStorage.getItem('formulasearch-theme') || '' } catch {}
    setTheme(savedTheme === 'dark' ? 'dark' : 'light')
    syncAmbientTheme = () => window.dispatchEvent(new CustomEvent('formulasearch:theme', {
      detail: { theme: document.documentElement.dataset.theme },
    }))
    syncAmbientTheme()

    let themeChanging = false
    themeToggle?.addEventListener('click', () => {
      if (themeChanging) return
      const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
      const commitTheme = () => saveTheme(nextTheme)

      if (reduceMotion || !document.startViewTransition) {
        commitTheme()
        return
      }

      const rect = themeToggle.getBoundingClientRect()
      const x = rect.left + rect.width / 2
      const y = rect.top + rect.height / 2
      const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y))

      document.documentElement.style.setProperty('--theme-x', `${x}px`)
      document.documentElement.style.setProperty('--theme-y', `${y}px`)
      document.documentElement.style.setProperty('--theme-radius', `${radius}px`)
      document.documentElement.classList.add('is-theme-switching')
      themeChanging = true

      try {
        const transition = document.startViewTransition(commitTheme)
        const finishThemeSwitch = () => {
          themeChanging = false
          document.documentElement.classList.remove('is-theme-switching')
        }
        transition.finished.then(finishThemeSwitch, finishThemeSwitch)
      } catch {
        commitTheme()
        themeChanging = false
        document.documentElement.classList.remove('is-theme-switching')
      }
    })

    let playedBefore = false
    if (!isLocalPreview) {
      try { playedBefore = sessionStorage.getItem(storageKey) === 'true' } catch {}
    }

    if (reduceMotion || playedBefore) {
      window.setTimeout(revealPage, reduceMotion ? 180 : 0)
    } else {
      const followIntroAnimation = (event) => {
        if (event.target !== introMotion || event.animationName !== 'logo-zoom') return
        if (event.type === 'animationstart') {
          unveilPage()
          trackLineWeight()
        }
        if (event.type === 'animationend') revealPage()
      }

      introMotion?.addEventListener('animationstart', followIntroAnimation)
      introMotion?.addEventListener('animationend', followIntroAnimation)
      window.setTimeout(unveilPage, 1200)
      window.setTimeout(revealPage, 3200)
    }
  </script>
</BaseLayout>
