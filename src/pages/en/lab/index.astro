---
import CatalogIndex from '../../../components/CatalogIndex.astro'
import CatalogLayout from '../../../layouts/CatalogLayout.astro'
import { catalogPages, labSections as sections } from '../../../data/catalog'
const page = catalogPages.lab
---

<CatalogLayout active="lab" locale="en" title={page.title} description={page.description}>
  <CatalogIndex locale="en" page={page} sections={sections} motionVariant="lab" />
</CatalogLayout>
