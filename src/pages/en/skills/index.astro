---
import CatalogIndex from '../../../components/CatalogIndex.astro'
import CatalogLayout from '../../../layouts/CatalogLayout.astro'
import { catalogPages, skillSections as sections } from '../../../data/catalog'
const page = catalogPages.skills
---

<CatalogLayout active="skills" locale="en" title={page.title} description={page.description}>
  <CatalogIndex locale="en" page={page} sections={sections} motionVariant="skills" />
</CatalogLayout>
