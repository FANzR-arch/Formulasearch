---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LocalizedText from '../../components/LocalizedText.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import { pageMeta } from '../../data/page-meta'
import { homeContent } from '../../lib/home-content'
---

<BaseLayout title={pageMeta.home.title.zh} titleEn={pageMeta.home.title.en} description={pageMeta.home.description.zh} descriptionEn={pageMeta.home.description.en} locale="en">
  <div id="site-page" class="site-page is-visible">
    <canvas id="ambient-flow" class="ambient-flow" aria-hidden="true"></canvas>
    <SiteHeader logoMode="background" locale="en" />

    <main id="main-content">
      <section class="intro" aria-labelledby="intro-title">
        <h1 id="intro-title"><LocalizedText zh={homeContent.zh.name} en={homeContent.en.name} /></h1>
        <p class="lead"><LocalizedText zh={homeContent.zh.intro.join(' ')} en={homeContent.en.intro.join(' ')} /></p>
        <div class="home-copy">
          {homeContent.zh.about.map((paragraph, index) => <p><LocalizedText zh={paragraph} en={homeContent.en.about[index]} /></p>)}
          {homeContent.zh.interest.map((paragraph, index) => <p><LocalizedText zh={paragraph} en={homeContent.en.interest[index]} /></p>)}
          <hr />
          <div class="home-contact">
            <p class="home-copy__label"><LocalizedText zh={homeContent.zh.contactLabel} en={homeContent.en.contactLabel} /></p>
            <p>
              <a class="text-link" href={homeContent.zh.social.url} target="_blank" rel="noopener noreferrer">{homeContent.zh.social.label}</a>
              <br />
              <LocalizedText zh={homeContent.zh.contactEmailPrefix} en={homeContent.en.contactEmailPrefix} /><strong><a class="text-link" href={`mailto:${homeContent.zh.email}`}>{homeContent.zh.email}</a></strong>
            </p>
          </div>
          <hr />
          <p><LocalizedText zh={homeContent.zh.sponsor} en={homeContent.en.sponsor} /></p>
        </div>
        {homeContent.zh.heroImage && <img class="hero-image" src={homeContent.zh.heroImage} alt={homeContent.en.heroImageAlt} data-alt-zh={homeContent.zh.heroImageAlt} data-alt-en={homeContent.en.heroImageAlt} width={homeContent.zh.heroImageWidth} height={homeContent.zh.heroImageHeight} loading="eager" />}
      </section>
    </main>
    <SiteFooter locale="en" />
  </div>
  <script is:inline src="/scripts/liquid-background.js"></script>
</BaseLayout>
