---
import CatalogLayout from '../../layouts/CatalogLayout.astro'
import LocalizedText from '../../components/LocalizedText.astro'
import { skillSections as sections } from '../../data/catalog'
---

<CatalogLayout active="skills" title={{ zh: '技能', en: 'Skills' }} description={{ zh: 'Phil 的设计 Skills、Agent 工具与可复用工作流。', en: "Phil's design Skills, agent tools, and reusable workflows." }}>
  <header class="catalog-hero">
    <p><LocalizedText zh="拿走、改造、变成自己的" en="Take it, adapt it, make it yours" /></p>
    <h1><LocalizedText zh="技能" en="Skills" /></h1>
    <span><LocalizedText zh="可以直接拿走使用的视觉方法、Agent 工具与工作流。" en="Visual methods, agent tools, and workflows you can use directly." /></span>
  </header>
  <nav class="catalog-index" aria-label="技能分类" data-aria-en="Skill categories" data-aria-zh="技能分类">
    {sections.map((section) => <a href={`#${section.id}`}><span>{section.label}</span><LocalizedText {...section.title} /></a>)}
  </nav>
  <div class="catalog-sections">
    {sections.map((section) => <section id={section.id} class="catalog-section">
      <p class="catalog-section__number">{section.label}</p>
      <div><h2><LocalizedText {...section.title} /></h2><p><LocalizedText {...section.description} /></p></div>
      <ul>{section.items.map((item) => <li><LocalizedText {...item} /></li>)}</ul>
    </section>)}
  </div>
</CatalogLayout>
