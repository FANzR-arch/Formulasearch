---
import CatalogLayout from '../../layouts/CatalogLayout.astro'
import CatalogIndex from '../../components/CatalogIndex.astro'
import { catalogPages, skillSections as sections } from '../../data/catalog'
const page = catalogPages.skills
---

<CatalogLayout active="skills" title={page.title} description={page.description}>
  <CatalogIndex page={page} sections={sections} motionVariant="skills" />
</CatalogLayout>
