---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BlogPostLayout from '../../layouts/BlogPostLayout.astro'
import { getBlogCategories } from '../../lib/blog-content'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.contentStatus === 'full' && !data.draft)
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const category = getBlogCategories().find((item) => item.id === post.data.category)
---

<BlogPostLayout post={post} headings={headings} categoryLabel={category?.titleEn ?? post.data.category}>
  <Content />
</BlogPostLayout>
