---
import BlogLatestView from '../../../components/BlogLatestView.astro'
import BlogLayout from '../../../layouts/BlogLayout.astro'
import { blogSectionNavigation, type BlogSectionId } from '../../../data/blog-navigation'
import { pageMeta } from '../../../data/page-meta'

export const getStaticPaths = () => blogSectionNavigation.items
  .filter((item) => item.id !== 'all')
  .map((item) => ({ params: { section: item.id }, props: { section: item.id } }))

const { section } = Astro.props as { section: Exclude<BlogSectionId, 'all'> }
const item = blogSectionNavigation.items.find((entry) => entry.id === section)!
const description = item.description ?? pageMeta.blog.description
const title = { zh: `${item.label.zh} · ${pageMeta.blog.title.zh}`, en: `${item.label.en} · ${pageMeta.blog.title.en}` }
---

<BlogLayout title={title.zh} titleEn={title.en} description={description.zh} descriptionEn={description.en}>
  <BlogLatestView active={section} />
</BlogLayout>
