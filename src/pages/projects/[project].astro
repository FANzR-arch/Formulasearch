---
import ProjectDetail from '../../components/ProjectDetail.astro'
import CatalogLayout from '../../layouts/CatalogLayout.astro'
import { type CatalogProjectItem, projectItems } from '../../data/catalog'

export const getStaticPaths = () => projectItems.map((project) => ({ params: { project: project.id }, props: { project } }))

const { project } = Astro.props as { project: CatalogProjectItem }
const title = { zh: project.zh, en: project.en }
---

<CatalogLayout active="projects" title={title} description={project.description}>
  <ProjectDetail project={project} />
</CatalogLayout>
