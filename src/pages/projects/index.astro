---
import CatalogLayout from '../../layouts/CatalogLayout.astro'
import LocalizedText from '../../components/LocalizedText.astro'
import { projectSections as sections } from '../../data/catalog'
---

<CatalogLayout active="projects" title={{ zh: '项目', en: 'Projects' }} description={{ zh: 'Phil 的产品、工具、网站与公开项目。', en: "Phil's products, tools, websites, and public projects." }}>
  <header class="catalog-hero">
    <p><LocalizedText zh="精选工作 / 有用的产出" en="Selected work / useful output" /></p>
    <h1><LocalizedText zh="项目" en="Projects" /></h1>
    <span><LocalizedText zh="产品、工具、网站与持续迭代的数字体验。" en="Products, tools, websites, and digital experiences in progress." /></span>
  </header>
  <nav class="catalog-index" aria-label="项目分类" data-aria-en="Project categories" data-aria-zh="项目分类">
    {sections.map((section) => <a href={`#${section.id}`}><span>{section.label}</span><LocalizedText {...section.title} /></a>)}
  </nav>
  <div class="catalog-sections">
    {sections.map((section) => <section id={section.id} class="catalog-section">
      <p class="catalog-section__number">{section.label}</p>
      <div><h2><LocalizedText {...section.title} /></h2><p><LocalizedText {...section.description} /></p></div>
      <ul>{section.items.map((item) => <li><LocalizedText {...item} /></li>)}</ul>
    </section>)}
  </div>
</CatalogLayout>
