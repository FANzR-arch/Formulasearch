---
import Icon from '../../components/icon-system/Icon.astro'
import '../studio.css'

interface Props { title: string; eyebrow: string }
const { title, eyebrow } = Astro.props
const pathname = Astro.url.pathname
const nav = [
  { href: '/content-studio', label: '控制中心', detail: '今日入口', icon: 'studio-home' as const },
  { href: '/content-studio/editor', label: '内容编辑', detail: 'Keystatic', icon: 'studio-editor' as const },
  { href: '/content-studio/photos', label: '照片管理', detail: '导入与整理', icon: 'studio-camera' as const },
  { href: '/content-studio/publish', label: '预览与发布', detail: '检查与确认', icon: 'studio-publish' as const },
]
---

<!doctype html>
<html lang="zh-CN" data-theme="formula">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="data:," />
    <title>{title} · Formula Content Studio</title>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content antialiased">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:btn focus:btn-primary" href="#studio-main">跳到主要内容</a>
    <div class="drawer lg:drawer-open">
      <input id="studio-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content min-w-0">
        <header class="navbar sticky top-0 z-30 border-b border-base-300 bg-base-100 px-4 lg:hidden">
          <label for="studio-drawer" class="btn btn-square btn-ghost" aria-label="打开后台导航"><Icon name="studio-menu" role="control" /></label>
          <a class="ml-2 font-serif text-lg font-semibold" href="/content-studio">Formula Studio</a>
          <span class="badge badge-success badge-sm ml-auto gap-1">Local</span>
        </header>
        <main id="studio-main" class="mx-auto w-full max-w-[1500px] px-5 pb-20 pt-10 sm:px-8 lg:px-12 lg:pt-14 xl:px-16">
          <header class="mb-10 grid gap-5 border-b border-neutral pb-7 md:grid-cols-[minmax(10rem,22%)_1fr] md:items-end lg:mb-14">
            <p class="studio-kicker m-0">{eyebrow}</p>
            <h1 class="studio-title m-0">{title}</h1>
          </header>
          <slot />
        </main>
      </div>
      <div class="drawer-side z-40">
        <label for="studio-drawer" aria-label="关闭后台导航" class="drawer-overlay"></label>
        <aside class="flex min-h-full w-72 flex-col border-r border-base-300 bg-base-100 px-5 py-6">
          <a class="mb-12 grid grid-cols-[2.75rem_1fr] items-center gap-x-3 no-underline" href="/content-studio">
            <span class="row-span-2 grid size-11 place-items-center bg-neutral font-serif text-2xl font-bold text-neutral-content">F</span>
            <strong class="font-serif text-lg leading-none">Formula</strong>
            <small class="mt-1 text-[.65rem] font-bold uppercase tracking-[.14em] text-base-content/55">Content Studio · Local</small>
          </a>
          <nav aria-label="内容后台导航">
            <ul class="menu w-full gap-1 p-0">
              {nav.map(({ href, label, detail, icon }) => (
                <li>
                  <a href={href} class:list={['grid min-h-14 grid-cols-[1.5rem_1fr] gap-x-3 rounded-field px-3', pathname === href && 'menu-active']} aria-current={pathname === href ? 'page' : undefined}>
                    <Icon name={icon} role="control" />
                    <span class="font-semibold leading-tight">{label}<small class="mt-1 block text-[.68rem] font-normal text-current/60">{detail}</small></span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="mt-auto border-t border-base-300 pt-5">
            <div class="alert alert-success items-start gap-3 rounded-box p-3 text-xs leading-relaxed" role="note">
              <Icon name="studio-settings" role="control" />
              <span><strong class="block">本机安全模式</strong>仅监听 127.0.0.1<br />保存不会提交或部署</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </body>
</html>
