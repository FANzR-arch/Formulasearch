---
import SiteHeader from '../components/SiteHeader.astro'
import LocalizedText from '../components/LocalizedText.astro'
import BaseLayout from './BaseLayout.astro'
import '../styles/blog.css'

interface Props {
  description: string
  image?: string
  ogType?: 'website' | 'article'
  publishedTime?: string
  structuredData?: Record<string, unknown>
  title: string
}

const { description, image, ogType, publishedTime, structuredData, title } = Astro.props
---

<BaseLayout title={`${title} · Phil / Formula`} description={description} image={image} ogType={ogType} publishedTime={publishedTime} structuredData={structuredData}>
  <div class="site-page is-visible blog-site">
    <SiteHeader active="blog" />
    <main id="main-content" class="blog-main"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Phil / Formula</span>
      <a href="/"><LocalizedText zh="返回首页" en="Return home" /></a>
    </footer>
  </div>

</BaseLayout>
