---
import '../styles/global.css'
import { siteConfig } from '../data/site-config'
import { uiCopy } from '../data/ui-copy'

interface Props {
  description: string
  descriptionEn?: string
  image?: string
  modifiedTime?: string
  ogType?: 'website' | 'article'
  publishedTime?: string
  structuredData?: Record<string, unknown>
  title: string
  titleEn?: string
}

const {
  description,
  descriptionEn,
  image,
  modifiedTime,
  ogType = 'website',
  publishedTime,
  structuredData,
  title,
  titleEn,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = image ? new URL(image, Astro.site) : undefined
const localizedTitleEn = titleEn ?? title
const localizedDescriptionEn = descriptionEn ?? description
---

<!doctype html>
<html lang="zh-Hans" data-locale="zh" data-theme="light" data-meta-title-zh={title} data-meta-title-en={localizedTitleEn} data-meta-description-zh={description} data-meta-description-en={localizedDescriptionEn}
  data-theme-color-light={siteConfig.themeColors.light} data-theme-color-dark={siteConfig.themeColors.dark}
  data-theme-to-dark-zh={uiCopy.navigation.themeToDark.zh} data-theme-to-dark-en={uiCopy.navigation.themeToDark.en}
  data-theme-to-light-zh={uiCopy.navigation.themeToLight.zh} data-theme-to-light-en={uiCopy.navigation.themeToLight.en}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={siteConfig.themeColors.light} />
    <meta name="description" content={description} />
    <link rel="icon" href="/brand/logo.svg" type="image/svg+xml" />
    <meta id="og-locale" property="og:locale" content="zh_CN" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta id="og-title" property="og:title" content={title} />
    <meta id="og-description" property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta id="twitter-title" name="twitter:title" content={title} />
    <meta id="twitter-description" name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
    <script is:inline src="/scripts/site-shell.js"></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: siteConfig.author.name,
      alternateName: siteConfig.author.alternateNames,
      url: siteConfig.author.url,
      jobTitle: siteConfig.author.jobTitle,
      knowsAbout: siteConfig.author.knowsAbout,
    })} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <span class="localized-text__zh">{uiCopy.navigation.skipToContent.zh}</span>
      <span class="localized-text__en">{uiCopy.navigation.skipToContent.en}</span>
    </a>
    <slot />
  </body>
</html>
