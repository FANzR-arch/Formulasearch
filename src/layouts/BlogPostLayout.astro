---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { ArrowLeft, ArrowRight, ArrowUpRight, Clock3, House, Link } from '@lucide/astro'
import LocalizedText from '../components/LocalizedText.astro'
import ExternalLinkLabel from '../components/ExternalLinkLabel.astro'
import BlogLayout from './BlogLayout.astro'
import { getBlogMedia } from '../data/blog-media'
import { siteConfig } from '../data/site-config'

interface Props {
  categoryLabel: { title: string; titleEn: string }
  headings: MarkdownHeading[]
  post: CollectionEntry<'blog'>
}

const { categoryLabel, headings, post } = Astro.props
const coverMedia = getBlogMedia(post.data.cover)
const coverSrcSet = coverMedia.optimized.map((variant) => `${variant.src} ${variant.width}w`).join(', ')
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const published = post.data.pubDate.toISOString().slice(0, 10)
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)
const displayDate = published.replaceAll('-', '.')
const canonical = new URL(`/blog/${post.data.slug}`, Astro.site).toString()
const readingMinutes = Math.max(1, Math.ceil((post.body ?? '').replace(/\s+/g, '').length / 500))
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      image: new URL(post.data.cover, Astro.site).toString(),
      url: canonical,
      articleSection: categoryLabel.title,
      ...(post.data.tags.length > 0 ? { keywords: post.data.tags } : {}),
      inLanguage: post.data.contentLanguage,
      datePublished: published,
      author: { '@type': 'Person', name: siteConfig.author.name, url: siteConfig.author.url },
      mainEntityOfPage: canonical,
      dateModified: modified,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL('/blog', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: categoryLabel.title, item: new URL('/blog/series', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
      ],
    },
  ],
}
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  modifiedTime={modified}
  ogType="article"
  publishedTime={published}
  structuredData={structuredData}
>
    <article class="article-page" lang={post.data.contentLanguage}>
    <nav class="article-context" aria-label="文章位置" data-aria-en="Article location" data-aria-zh="文章位置">
      <div class="article-context__inner">
        <a href="/blog"><House aria-hidden="true" size={14} stroke-width={1.7} /> <LocalizedText zh="博客" en="Blog" /></a>
        <span class="article-context__pill"><LocalizedText zh={categoryLabel.title} en={categoryLabel.titleEn} /></span>
      </div>
    </nav>

    <div class="article-grid">
      <header class="article-header">
        <p class="article-meta"><time datetime={published}>{displayDate}</time></p>
        <h1>{post.data.title}</h1>
        <div class="article-byline">
          <p class="article-author"><span class="article-author__mark" aria-hidden="true">P</span><strong>Phil</strong></p>
          <p class="article-tools"><span><Clock3 aria-hidden="true" size={14} stroke-width={1.7} /><LocalizedText zh={`${readingMinutes} 分钟阅读`} en={`${readingMinutes} min read`} /></span><button class="article-copy" type="button" data-copy-url={canonical} aria-live="polite"><Link aria-hidden="true" size={14} stroke-width={1.7} /><LocalizedText zh="复制链接" en="Copy link" /></button></p>
        </div>
      </header>

      <figure class="article-cover">
        <picture>
          <source type="image/webp" srcset={coverSrcSet} sizes="(max-width: 820px) 100vw, 880px" />
          <img src={post.data.cover} alt={post.data.coverAlt} data-alt-zh={post.data.coverAlt} data-alt-en="Article cover" decoding="async" fetchpriority="high" width={coverMedia.width} height={coverMedia.height} sizes="(max-width: 820px) 100vw, 880px" />
        </picture>
      </figure>

      {toc.length > 1 && (
        <details class="article-toc" open>
          <summary><LocalizedText zh="本页目录" en="On this page" /></summary>
          <nav aria-label="文章目录" data-aria-en="Article contents" data-aria-zh="文章目录">
            {toc.map((heading) => <a class:list={{ 'is-subheading': heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}
          </nav>
        </details>
      )}

      <div class="article-prose"><slot /></div>

      <footer class="article-footer">
        <a href="/blog"><ArrowLeft aria-hidden="true" size={14} stroke-width={1.7} /> <LocalizedText zh="返回博客" en="Back to blog" /></a>
        <a href="/blog/archive"><LocalizedText zh="全部文章" en="All articles" /> <ArrowRight aria-hidden="true" size={14} stroke-width={1.7} /></a>
      </footer>

      {post.data.externalLinks.length > 0 && (
        <aside class="article-sources">
          <p><LocalizedText zh="原文发布" en="Originally published on" /></p>
          <div class="post-row__links" aria-label="原文平台" data-aria-en="Original publication" data-aria-zh="原文平台">
            {post.data.externalLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer"><ExternalLinkLabel label={link.label} /><ArrowUpRight aria-hidden="true" size={13} stroke-width={1.7} /></a>)}
          </div>
        </aside>
      )}
    </div>
  </article>

  <script is:inline>
    document.querySelectorAll('.article-copy').forEach((button) => {
      button.addEventListener('click', async () => {
        const url = button.getAttribute('data-copy-url') || window.location.href
        try {
          await navigator.clipboard.writeText(url)
          button.querySelector('.localized-text')?.replaceWith(document.documentElement.dataset.locale === 'en' ? 'Copied' : '已复制')
        } catch {
          window.prompt(document.documentElement.dataset.locale === 'en' ? 'Copy article link' : '复制文章链接', url)
        }
      })
    })

    const tocLinks = [...document.querySelectorAll('.article-toc a')]
    const articleHeadings = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter(Boolean)

    const updateCurrentHeading = () => {
      if (!articleHeadings.length) return
      let current = articleHeadings[0]
      for (const heading of articleHeadings) {
        if (heading.getBoundingClientRect().top <= 180) current = heading
        else break
      }
      tocLinks.forEach((link) => {
        const active = decodeURIComponent(link.hash.slice(1)) === current.id
        link.classList.toggle('is-current', active)
        if (active) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      })
    }

    let tocFrame = 0
    const scheduleTocUpdate = () => {
      if (tocFrame) return
      tocFrame = requestAnimationFrame(() => {
        updateCurrentHeading()
        tocFrame = 0
      })
    }

    updateCurrentHeading()
    window.addEventListener('scroll', scheduleTocUpdate, { passive: true })
    window.addEventListener('hashchange', scheduleTocUpdate)
  </script>
</BlogLayout>
