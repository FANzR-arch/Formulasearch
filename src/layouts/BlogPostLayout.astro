---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'
import LocalizedText from '../components/LocalizedText.astro'
import BlogExternalLinks from '../components/BlogExternalLinks.astro'
import RelatedPosts from '../components/RelatedPosts.astro'
import BlogCover from '../components/BlogCover.astro'
import BlogLayout from './BlogLayout.astro'
import { siteConfig } from '../data/site-config'
import { uiCopy } from '../data/ui-copy'
import { getBlogPostRoute, getLocalizedRoute, siteRoutes } from '../data/site-routes'
import { getLocalizedValue, interpolateLocalizedCopy, type Locale } from '../lib/i18n'
import { blogSettings } from '../data/blog-settings'
import Icon from '../components/icon-system/Icon.astro'

interface Props {
  categoryLabel: { title: string; titleEn: string }
  headings: MarkdownHeading[]
  post: CollectionEntry<'blog'>
  relatedPosts: CollectionEntry<'blog'>[]
}

const { categoryLabel, headings, post, relatedPosts } = Astro.props
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const published = post.data.pubDate.toISOString().slice(0, 10)
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)
const displayDate = published.replaceAll('-', '.')
const contentLocale = post.data.contentLanguage === 'en' ? 'en' : 'zh'
const localizedBlogRoute = getLocalizedRoute(siteRoutes.blog, contentLocale)
const localizedSeriesRoute = getLocalizedRoute(siteRoutes.blogSeries, contentLocale)
const localizedArchiveRoute = getLocalizedRoute(siteRoutes.blogArchive, contentLocale)
const canonical = new URL(getBlogPostRoute(post.data.slug, post.data.contentLanguage), Astro.site).toString()
const readingUnits = post.data.contentLanguage === 'en'
  ? (post.body ?? '').trim().split(/\s+/).filter(Boolean).length
  : (post.body ?? '').replace(/\s+/g, '').length
const readingMinutes = Math.max(1, Math.ceil(readingUnits / blogSettings.readingUnitsPerMinute))
const readingTimeCopy = interpolateLocalizedCopy(uiCopy.blog.readingTime, {
  minutes: { zh: String(readingMinutes), en: String(readingMinutes) },
})
const titleEn = post.data.titleEn ?? post.data.title
const descriptionEn = post.data.descriptionEn ?? post.data.description
const titleEnLang = post.data.titleEn ? 'en' : 'zh-Hans'
const authorName = siteConfig.author.name
const authorMark = authorName.trim().slice(0, 1).toUpperCase()
const localizedCategory = contentLocale === 'en' ? categoryLabel.titleEn : categoryLabel.title
const structuredTitle = contentLocale === 'en' ? titleEn : post.data.title
const structuredDescription = contentLocale === 'en' ? descriptionEn : post.data.description
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: structuredTitle,
      description: structuredDescription,
      image: new URL(post.data.cover, Astro.site).toString(),
      url: canonical,
      articleSection: localizedCategory,
      ...(post.data.tags.length > 0 ? { keywords: post.data.tags } : {}),
      inLanguage: post.data.contentLanguage,
      datePublished: published,
      author: { '@type': 'Person', name: siteConfig.author.name, url: siteConfig.author.url },
      mainEntityOfPage: canonical,
      dateModified: modified,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: uiCopy.blog.blog[contentLocale], item: new URL(localizedBlogRoute, Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: localizedCategory, item: new URL(localizedSeriesRoute, Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
      ],
    },
  ],
}
---

<BlogLayout
  title={post.data.title}
  titleEn={titleEn}
  description={post.data.description}
  descriptionEn={descriptionEn}
  image={post.data.cover}
  locale={contentLocale as Locale}
  modifiedTime={modified}
  ogType="article"
  publishedTime={published}
  structuredData={structuredData}
>
    <article class="article-page" lang={post.data.contentLanguage}>
    <nav class="article-context" aria-label={getLocalizedValue(uiCopy.blog.articleLocation, contentLocale as Locale)} data-aria-en={uiCopy.blog.articleLocation.en} data-aria-zh={uiCopy.blog.articleLocation.zh} data-site-reveal>
      <div class="article-context__inner">
        <a href={localizedBlogRoute}><Icon name="blog-home" role="meta" /> <LocalizedText {...uiCopy.blog.blog} /></a>
        <span class="article-context__pill"><LocalizedText zh={categoryLabel.title} en={categoryLabel.titleEn} /></span>
      </div>
    </nav>

    <div class="article-grid">
      <header class="article-header" data-site-reveal data-site-reveal-delay="60">
        <p class="article-meta"><time datetime={published}>{displayDate}</time></p>
        <h1><LocalizedText zh={post.data.title} en={titleEn} enLang={titleEnLang} /></h1>
        <div class="article-byline">
          <p class="article-author"><span class="article-author__mark" aria-hidden="true">{authorMark}</span><strong>{authorName}</strong></p>
        <p class="article-tools"><span><Icon name="blog-time" role="meta" /><LocalizedText {...readingTimeCopy} /></span><span class="article-copy-wrap"><button class="article-copy" type="button" data-copy-url={canonical} data-no-sound aria-live="polite"><Icon name="blog-link" role="meta" /><span class="article-copy__default"><LocalizedText {...uiCopy.blog.copyLink} /></span><span class="article-copy__feedback"><LocalizedText {...uiCopy.blog.copied} /></span><span class="article-copy__failure"><LocalizedText {...uiCopy.blog.copyFailed} /></span></button><input class="article-copy__failure-url" type="text" value={canonical} readonly hidden aria-label={getLocalizedValue(uiCopy.blog.copyFailed, contentLocale as Locale)} data-aria-en={uiCopy.blog.copyFailed.en} data-aria-zh={uiCopy.blog.copyFailed.zh} /></span></p>
        </div>
      </header>

      <figure class="article-cover" data-site-reveal data-site-reveal-delay="100">
        <BlogCover src={post.data.cover} alt={post.data.coverAlt} altEn={post.data.coverAltEn} locale={contentLocale as Locale} fetchpriority="high" sizes="(max-width: 820px) 100vw, 880px" />
      </figure>

      {toc.length > 1 && (
        <details class="article-toc" open data-site-reveal>
          <summary><LocalizedText {...uiCopy.blog.onThisPage} /></summary>
          <nav aria-label={getLocalizedValue(uiCopy.blog.articleContents, contentLocale as Locale)} data-aria-en={uiCopy.blog.articleContents.en} data-aria-zh={uiCopy.blog.articleContents.zh}>
            {toc.map((heading) => <a class:list={{ 'is-subheading': heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}
          </nav>
        </details>
      )}

      <div class="article-prose" data-site-reveal><slot /></div>

      <footer class="article-footer" data-site-reveal>
        <a href={localizedBlogRoute}><Icon name="blog-back" role="meta" /> <LocalizedText {...uiCopy.blog.backToBlog} /></a>
        <a href={localizedArchiveRoute}><LocalizedText {...uiCopy.blog.allArticles} /> <Icon name="blog-forward" role="meta" /></a>
      </footer>

      <RelatedPosts posts={relatedPosts} />

      {post.data.externalLinks.length > 0 && (
        <aside class="article-sources">
          <p><LocalizedText {...uiCopy.blog.originallyPublished} /></p>
        <BlogExternalLinks links={post.data.externalLinks} locale={contentLocale as Locale} />
        </aside>
      )}
    </div>
  </article>

  <script is:inline src="/scripts/article-page.js"></script>
</BlogLayout>
