---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { ArrowLeft, ArrowRight, ArrowUpRight, Clock3, House, Link } from '@lucide/astro'
import LocalizedText from '../components/LocalizedText.astro'
import ExternalLinkLabel from '../components/ExternalLinkLabel.astro'
import RelatedPosts from '../components/RelatedPosts.astro'
import BlogCover from '../components/BlogCover.astro'
import BlogLayout from './BlogLayout.astro'
import { siteConfig } from '../data/site-config'
import { uiCopy } from '../data/ui-copy'
import { interpolateLocalizedCopy } from '../lib/i18n'

interface Props {
  categoryLabel: { title: string; titleEn: string }
  headings: MarkdownHeading[]
  post: CollectionEntry<'blog'>
  relatedPosts: CollectionEntry<'blog'>[]
}

const { categoryLabel, headings, post, relatedPosts } = Astro.props
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const published = post.data.pubDate.toISOString().slice(0, 10)
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)
const displayDate = published.replaceAll('-', '.')
const canonical = new URL(`/blog/${post.data.slug}`, Astro.site).toString()
const readingMinutes = Math.max(1, Math.ceil((post.body ?? '').replace(/\s+/g, '').length / 500))
const readingTimeCopy = interpolateLocalizedCopy(uiCopy.blog.readingTime, {
  minutes: { zh: String(readingMinutes), en: String(readingMinutes) },
})
const authorName = siteConfig.author.name
const authorMark = authorName.trim().slice(0, 1).toUpperCase()
const contentLocale = post.data.contentLanguage === 'en' ? 'en' : 'zh'
const localizedCategory = contentLocale === 'en' ? categoryLabel.titleEn : categoryLabel.title
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      image: new URL(post.data.cover, Astro.site).toString(),
      url: canonical,
      articleSection: localizedCategory,
      ...(post.data.tags.length > 0 ? { keywords: post.data.tags } : {}),
      inLanguage: post.data.contentLanguage,
      datePublished: published,
      author: { '@type': 'Person', name: siteConfig.author.name, url: siteConfig.author.url },
      mainEntityOfPage: canonical,
      dateModified: modified,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: uiCopy.blog.blog[contentLocale], item: new URL('/blog', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: localizedCategory, item: new URL('/blog/series', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
      ],
    },
  ],
}
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  modifiedTime={modified}
  ogType="article"
  publishedTime={published}
  structuredData={structuredData}
>
    <article class="article-page" lang={post.data.contentLanguage}>
    <nav class="article-context" aria-label={uiCopy.blog.articleLocation.zh} data-aria-en={uiCopy.blog.articleLocation.en} data-aria-zh={uiCopy.blog.articleLocation.zh}>
      <div class="article-context__inner">
        <a href="/blog"><House aria-hidden="true" size={14} stroke-width={1.7} /> <LocalizedText {...uiCopy.blog.blog} /></a>
        <span class="article-context__pill"><LocalizedText zh={categoryLabel.title} en={categoryLabel.titleEn} /></span>
      </div>
    </nav>

    <div class="article-grid">
      <header class="article-header">
        <p class="article-meta"><time datetime={published}>{displayDate}</time></p>
        <h1>{post.data.title}</h1>
        <div class="article-byline">
          <p class="article-author"><span class="article-author__mark" aria-hidden="true">{authorMark}</span><strong>{authorName}</strong></p>
        <p class="article-tools"><span><Clock3 aria-hidden="true" size={14} stroke-width={1.7} /><LocalizedText {...readingTimeCopy} /></span><button class="article-copy" type="button" data-copy-url={canonical} data-copy-prompt-zh={uiCopy.blog.copyArticleLink.zh} data-copy-prompt-en={uiCopy.blog.copyArticleLink.en} aria-live="polite"><Link aria-hidden="true" size={14} stroke-width={1.7} /><span class="article-copy__default"><LocalizedText {...uiCopy.blog.copyLink} /></span><span class="article-copy__feedback"><LocalizedText {...uiCopy.blog.copied} /></span></button></p>
        </div>
      </header>

      <figure class="article-cover">
        <BlogCover src={post.data.cover} alt={post.data.coverAlt} altEn={uiCopy.blog.articleCoverAlt.en} fetchpriority="high" sizes="(max-width: 820px) 100vw, 880px" />
      </figure>

      {toc.length > 1 && (
        <details class="article-toc" open>
          <summary><LocalizedText {...uiCopy.blog.onThisPage} /></summary>
          <nav aria-label={uiCopy.blog.articleContents.zh} data-aria-en={uiCopy.blog.articleContents.en} data-aria-zh={uiCopy.blog.articleContents.zh}>
            {toc.map((heading) => <a class:list={{ 'is-subheading': heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}
          </nav>
        </details>
      )}

      <div class="article-prose"><slot /></div>

      <footer class="article-footer">
        <a href="/blog"><ArrowLeft aria-hidden="true" size={14} stroke-width={1.7} /> <LocalizedText {...uiCopy.blog.backToBlog} /></a>
        <a href="/blog/archive"><LocalizedText {...uiCopy.blog.allArticles} /> <ArrowRight aria-hidden="true" size={14} stroke-width={1.7} /></a>
      </footer>

      <RelatedPosts posts={relatedPosts} />

      {post.data.externalLinks.length > 0 && (
        <aside class="article-sources">
          <p><LocalizedText {...uiCopy.blog.originallyPublished} /></p>
          <div class="post-row__links" aria-label={uiCopy.blog.originalPublication.zh} data-aria-en={uiCopy.blog.originalPublication.en} data-aria-zh={uiCopy.blog.originalPublication.zh}>
            {post.data.externalLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer"><ExternalLinkLabel label={link.label} /><ArrowUpRight aria-hidden="true" size={13} stroke-width={1.7} /></a>)}
          </div>
        </aside>
      )}
    </div>
  </article>

  <script is:inline>
    document.querySelectorAll('.article-copy').forEach((button) => {
      button.addEventListener('click', async () => {
        const url = button.getAttribute('data-copy-url') || window.location.href
        try {
          await navigator.clipboard.writeText(url)
          button.dataset.copyState = 'copied'
          window.setTimeout(() => {
            delete button.dataset.copyState
          }, 1800)
        } catch {
          const prompt = document.documentElement.dataset.locale === 'en'
            ? button.dataset.copyPromptEn
            : button.dataset.copyPromptZh
          window.prompt(prompt ?? '', url)
        }
      })
    })

    const tocLinks = [...document.querySelectorAll('.article-toc a')]
    const articleHeadings = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter(Boolean)

    const updateCurrentHeading = () => {
      if (!articleHeadings.length) return
      let current = articleHeadings[0]
      for (const heading of articleHeadings) {
        if (heading.getBoundingClientRect().top <= 180) current = heading
        else break
      }
      tocLinks.forEach((link) => {
        const active = decodeURIComponent(link.hash.slice(1)) === current.id
        link.classList.toggle('is-current', active)
        if (active) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      })
    }

    let tocFrame = 0
    const scheduleTocUpdate = () => {
      if (tocFrame) return
      tocFrame = requestAnimationFrame(() => {
        updateCurrentHeading()
        tocFrame = 0
      })
    }

    updateCurrentHeading()
    window.addEventListener('scroll', scheduleTocUpdate, { passive: true })
    window.addEventListener('hashchange', scheduleTocUpdate)
  </script>
</BlogLayout>
