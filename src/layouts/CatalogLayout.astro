---
import SiteHeader from '../components/SiteHeader.astro'
import LocalizedText from '../components/LocalizedText.astro'
import BaseLayout from './BaseLayout.astro'
import { siteConfig } from '../data/site-config'

interface Props {
  active: 'projects' | 'skills' | 'lab' | 'photos' | 'architecture'
  description: { en: string; zh: string }
  title: { en: string; zh: string }
  variant?: 'default' | 'archive'
}

const { active, description, title, variant = 'default' } = Astro.props
---

<BaseLayout title={`${title.zh} / ${siteConfig.name}`} titleEn={`${title.en} / ${siteConfig.name}`} description={description.zh} descriptionEn={description.en}>
  <div class:list={['site-page', 'is-visible', 'catalog-site', { 'archive-catalog-site': variant === 'archive' }]}>
    <SiteHeader active={active} />
    <main id="main-content" class="catalog-main"><slot /></main>
    <footer class="catalog-footer">
      <span>© {new Date().getFullYear()} {siteConfig.name}</span>
      <a href="/"><LocalizedText zh="返回首页" en="Return home" /></a>
    </footer>
  </div>

</BaseLayout>
