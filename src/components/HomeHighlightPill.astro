---
import Icon from './icon-system/Icon.astro'

interface Props {
  label: string
  className?: string
  detail?: string
  locale?: 'zh' | 'en'
  terminal?: boolean
}

const { label, className = 'home-copy__highlight', detail, locale = 'zh', terminal = false } = Astro.props
const detailId = `home-note-${locale}-${encodeURIComponent(label)}`
const Tag = detail ? 'button' : 'span'
---

<Tag class:list={[className, { 'home-keyword--terminal': terminal }]} type={detail ? 'button' : undefined} data-highlight-label={label} data-cursor-state="capsule" data-home-keyword={detail ? '' : undefined} aria-expanded={detail ? 'false' : undefined} aria-controls={detail ? detailId : undefined}>
  {terminal ? <><span class="home-terminal__prompt" aria-hidden="true"><Icon name="home-terminal-prompt" role="meta" /></span><span class="home-terminal__label"><span class="home-terminal__reserve">{label}<span class="home-terminal__caret"></span></span><span class="home-terminal__visual" aria-hidden="true"><span data-home-terminal-text>{label}</span><span class="home-terminal__caret"></span></span></span></> : <span class="home-highlight-pill__track">
    <span class="home-highlight-pill__text">{label}</span>
    <span class="home-highlight-pill__text home-highlight-pill__text--clone" aria-hidden="true">{label}</span>
  </span>}
</Tag>{detail && <span id={detailId} class="home-keyword-note" hidden><span class="home-keyword-note__accessible">{detail}</span><span data-home-note-text aria-hidden="true"></span></span>}

<style>
  button[data-home-keyword] { font: inherit; color: inherit; letter-spacing: inherit; line-height: 1.25; vertical-align: baseline; }
  button[data-home-keyword][aria-expanded='true'] { color: var(--ink); border-color: color-mix(in oklab, var(--ink) 35%, transparent); background: color-mix(in oklab, var(--ink) 12%, transparent); }
  button[data-home-keyword][aria-expanded='true']::before { opacity: 0; }
  @media (hover: hover) and (pointer: fine) {
    button[data-home-keyword]:hover:not([aria-expanded='true']):not(.home-keyword--terminal) { color: var(--paper); }
  }
  button[data-home-keyword]:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  button.home-keyword--terminal,
  button.home-keyword--terminal:is(:hover, [aria-expanded='true']) { display: inline-flex; align-items: baseline; gap: .25em; max-width: 100%; margin-inline: .12em; padding: .22em .5em .25em .35em; border: 1px solid var(--hairline); border-radius: 5px; background: var(--code-paper); color: var(--code-ink); font-family: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace; font-size: .84em; letter-spacing: -.025em; line-height: 1.4; text-align: start; text-decoration: none; }
  button.home-keyword--terminal::before { content: none; }
  .home-terminal__prompt { display: inline-flex; flex: 0 0 auto; align-self: center; opacity: .5; }
  .home-terminal__label { display: grid; min-width: 0; white-space: normal; }
  .home-terminal__reserve, .home-terminal__visual { grid-area: 1 / 1; }
  .home-terminal__reserve { opacity: 0; }
  .home-terminal__caret { display: inline-block; height: .95em; margin-left: .18em; border-right: 1px solid currentColor; vertical-align: -.12em; opacity: .65; }
  .home-keyword--terminal:is(:hover, :focus-visible) .home-terminal__caret { animation: home-note-caret 800ms step-end infinite; }
  .home-keyword-note { margin-inline: .35em; color: var(--muted); font-size: .9em; white-space: normal; overflow-wrap: anywhere; }
  .home-keyword-note[hidden] { display: none; }
  [data-home-note-text] { padding: .03em .18em; border-radius: .15em; background: color-mix(in oklab, var(--ink) 6%, transparent); -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .home-keyword-note__accessible { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .home-keyword-note[data-typing] [data-home-note-text]::after { content: ''; display: inline-block; height: .85em; border-right: 1px solid currentColor; margin-inline: .08em; vertical-align: -.04em; animation: home-note-caret 700ms step-end infinite; }
  @keyframes home-note-caret { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    button[data-home-keyword], button[data-home-keyword]::before, .home-highlight-pill__track { transition: none; }
    .home-keyword-note[data-typing] [data-home-note-text]::after { display: none; }
    .home-keyword--terminal:is(:hover, :focus-visible) .home-terminal__caret { animation: none; }
  }
</style>

<script>
  // Each keyword owns its note and timer so multiple explanations can stay open.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  // The full label reserves its space and accessible name while the visual copy types.
  const terminalTimers = new Map<HTMLElement, ReturnType<typeof setTimeout>>()
  const finishTerminal = (button: HTMLElement) => {
    clearTimeout(terminalTimers.get(button))
    terminalTimers.delete(button)
    const visual = button.querySelector<HTMLElement>('[data-home-terminal-text]')
    if (visual) visual.textContent = button.dataset.highlightLabel || ''
  }
  const playTerminal = (button: HTMLElement) => {
    finishTerminal(button)
    if (reducedMotion.matches) return
    const visual = button.querySelector<HTMLElement>('[data-home-terminal-text]')
    if (!visual) return
    const characters = Array.from(button.dataset.highlightLabel || '')
    let index = 0
    visual.textContent = ''
    const type = () => {
      visual.textContent = characters.slice(0, ++index).join('')
      if (index < characters.length) terminalTimers.set(button, setTimeout(type, 40))
      else terminalTimers.delete(button)
    }
    terminalTimers.set(button, setTimeout(type, 40))
  }
  for (const eventName of ['pointerover', 'focusin']) {
    document.addEventListener(eventName, (event) => {
      if (!(event.target instanceof Element)) return
      if (event instanceof PointerEvent && event.pointerType !== 'mouse') return
      const button = event.target.closest<HTMLElement>('.home-keyword--terminal')
      if (!button || ((event as MouseEvent).relatedTarget instanceof Node && button.contains((event as MouseEvent).relatedTarget as Node))) return
      if (eventName === 'focusin' && button.matches(':hover')) return
      playTerminal(button)
    })
  }
  for (const eventName of ['pointerout', 'focusout']) {
    document.addEventListener(eventName, (event) => {
      if (!(event.target instanceof Element)) return
      const button = event.target.closest<HTMLElement>('.home-keyword--terminal')
      if (!button || ((event as MouseEvent).relatedTarget instanceof Node && button.contains((event as MouseEvent).relatedTarget as Node))) return
      finishTerminal(button)
    })
  }
  const finishTerminals = () => { for (const button of terminalTimers.keys()) finishTerminal(button) }
  window.addEventListener('formulasearch:locale', finishTerminals)
  window.addEventListener('pagehide', finishTerminals)
  document.addEventListener('astro:before-swap', finishTerminals)
  reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) finishTerminals() })
  document.addEventListener('visibilitychange', () => { if (document.hidden) finishTerminals() })
  type OpenNote = { note: HTMLElement; visual: HTMLElement; text: string; timer?: ReturnType<typeof setTimeout>; frame?: number; closing?: boolean }
  const openNotes = new Map<HTMLButtonElement, OpenNote>()

  const closeNote = (button: HTMLButtonElement, immediate = false) => {
    const state = openNotes.get(button)
    if (!state) return
    clearTimeout(state.timer)
    if (state.frame !== undefined) cancelAnimationFrame(state.frame)
    const { note, visual } = state
    state.closing = true
    button.setAttribute('aria-expanded', 'false')
    const hide = () => {
      note.hidden = true
      visual.textContent = ''
      delete note.dataset.typing
      openNotes.delete(button)
    }
    if (immediate || reducedMotion.matches) hide()
    else {
      // Retract only the text already shown, with a shorter duration than typing in.
      const characters = Array.from(visual.textContent || '')
      const duration = Math.min(480, Math.max(160, characters.length * 9))
      const started = performance.now()
      note.dataset.typing = ''
      const erase = (now: number) => {
        if (openNotes.get(button) !== state) return
        const progress = Math.min(1, (now - started) / duration)
        const remaining = Math.max(0, Math.min(characters.length - 1, Math.ceil(characters.length * (1 - progress))))
        visual.textContent = characters.slice(0, remaining).join('')
        if (remaining === 0) { hide(); return }
        state.frame = requestAnimationFrame(erase)
      }
      state.frame = requestAnimationFrame(erase)
    }
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return
    const button = event.target.closest<HTMLButtonElement>('button[data-home-keyword]')
    if (!button) return
    const previous = openNotes.get(button)
    if (previous && !previous.closing) { closeNote(button); return }
    if (previous?.frame !== undefined) cancelAnimationFrame(previous.frame)
    const note = document.getElementById(button.getAttribute('aria-controls') || '')
    const visual = note?.querySelector<HTMLElement>('[data-home-note-text]')
    const text = note?.querySelector('.home-keyword-note__accessible')?.textContent || ''
    if (!note || !visual || !text) return
    note.getAnimations().forEach((animation) => animation.cancel())
    note.hidden = false
    button.setAttribute('aria-expanded', 'true')
    const state: OpenNote = { note, visual, text }
    openNotes.set(button, state)
    if (reducedMotion.matches) { visual.textContent = text; return }
    note.dataset.typing = ''
    const characters = Array.from(text)
    const interval = button.closest('[lang]')?.getAttribute('lang') === 'en' ? 12 : 26
    // Clicking again during retraction resumes from the visible text.
    let index = Array.from(visual.textContent || '').length
    const typeNext = () => {
      if (openNotes.get(button) !== state) return
      visual.textContent = characters.slice(0, index = Math.min(index + 1, characters.length)).join('')
      if (index >= characters.length) { delete note.dataset.typing; return }
      const pause = /[，。；：！？,.!?;:]/.test(characters[index - 1]) ? 100 : interval
      state.timer = setTimeout(typeNext, pause)
    }
    typeNext()
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(event.target instanceof Element)) return
    const button = event.target.closest<HTMLButtonElement>('button[data-home-keyword]')
    if (button) closeNote(button)
  })
  const closeAllNotes = () => { for (const button of openNotes.keys()) closeNote(button, true) }
  window.addEventListener('formulasearch:locale', closeAllNotes)
  window.addEventListener('pagehide', closeAllNotes)
  document.addEventListener('astro:before-swap', closeAllNotes)
  const finishTyping = () => {
    for (const [button, state] of openNotes) {
      if (state.closing) { closeNote(button, true); continue }
      clearTimeout(state.timer)
      state.visual.textContent = state.text
      delete state.note.dataset.typing
    }
  }
  reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) finishTyping() })
  document.addEventListener('visibilitychange', () => { if (document.hidden) finishTyping() })
</script>
