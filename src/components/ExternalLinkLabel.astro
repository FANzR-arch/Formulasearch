---
import LocalizedText from './LocalizedText.astro'

interface Props {
  label: '微信' | 'X' | '原文'
}

const labels = {
  微信: { zh: '微信', en: 'WeChat' },
  X: { zh: 'X', en: 'X' },
  原文: { zh: '原文', en: 'Original' },
} as const

const { label } = Astro.props
---

<LocalizedText {...labels[label]} />
