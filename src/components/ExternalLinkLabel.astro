---
import LocalizedText from './LocalizedText.astro'
import { uiCopy } from '../data/ui-copy'

interface Props {
  label: '微信' | 'X' | '原文'
}

const labels = {
  微信: uiCopy.platforms.wechat,
  X: uiCopy.platforms.x,
  原文: uiCopy.platforms.original,
} as const

const { label } = Astro.props
---

<LocalizedText {...labels[label]} />
