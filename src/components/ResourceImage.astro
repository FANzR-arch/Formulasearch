---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import BlogCover from './BlogCover.astro'
import ThemeImage from './ThemeImage.astro'
import type { ResourceLinkItem } from '../data/catalog'
import type { BlogPost } from '../lib/blog-content'
import { getLocalizedValue, type Locale } from '../lib/i18n'
import { getBlogMedia } from '../data/blog-media'

interface Props {
  item: ResourceLinkItem
  post?: BlogPost
  locale?: Locale
  sizes: string
  className?: string
  widths?: number[]
}

const { item, post, locale = 'zh', sizes, className = 'resource-card__image', widths } = Astro.props
const sources = import.meta.glob<ImageMetadata>('/public/uploads/{resources,projects}/**/*.{webp,png,jpg,jpeg,avif}', { eager: true, import: 'default' })
const resolveImage = (src: string) => {
  const source = sources[`/public${src}`]
  if (!source) throw new Error(`Resource "${item.id}" is missing local image "${src}".`)
  return source
}
const alt = item.imageAlt ?? { zh: `${item.zh} 首页截图`, en: `${item.en} homepage screenshot` }
const imageWidths = widths ?? [160, 320, 640, 960]
const postMedia = post && getBlogMedia(post.cover)
const postClassName = `${className}${postMedia && postMedia.width / postMedia.height < 2.2 && !widths ? ' resource-card__image--contain' : ''}`
if (!item.image && !post) throw new Error(`Resource "${item.id}" needs a local image or a related article cover.`)
---

{typeof item.image === 'string' ? (
  <Image src={resolveImage(item.image)} width={imageWidths[0]} widths={imageWidths} sizes={sizes} format="webp" quality={82} alt={getLocalizedValue(alt, locale)} data-alt-zh={alt.zh} data-alt-en={alt.en} class={className} loading="lazy" decoding="async" />
) : item.image ? (
  <ThemeImage light={resolveImage(item.image.light)} dark={resolveImage(item.image.dark)} widths={imageWidths} sizes={sizes} class={className} alt={getLocalizedValue(alt, locale)} altZh={alt.zh} altEn={alt.en} />
) : post && (
  <BlogCover src={post.cover} alt={post.coverAlt} altEn={post.coverAltEn} locale={locale} sizes={sizes} className={postClassName} widths={widths} loading="lazy" decoding="async" />
)}
