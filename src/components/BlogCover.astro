---
import { getBlogMedia } from '../data/blog-media'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { Locale } from '../lib/i18n'

interface Props {
  alt?: string
  altEn?: string
  className?: string
  decoding?: 'async' | 'auto' | 'sync'
  fetchpriority?: 'high' | 'low' | 'auto'
  loading?: 'eager' | 'lazy'
  locale?: Locale
  sizes: string
  src: string
  widths?: number[]
}

const {
  alt = '',
  altEn,
  className,
  decoding = 'async',
  fetchpriority,
  loading,
  locale = 'zh',
  sizes,
  src,
  widths,
} = Astro.props
const media = getBlogMedia(src)
const thumbnailSources = import.meta.glob<ImageMetadata>('/public/uploads/blog/**/*.{png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' })
const thumbnails = widths && await Promise.all(widths.map((width) => {
  const source = thumbnailSources[`/public${src}`]
  if (!source) throw new Error(`Missing blog thumbnail source: ${src}`)
  return getImage({ src: source, width, format: 'webp', quality: 78 })
}))
const localizedAlt = locale === 'en' ? (altEn ?? alt) : alt
const mediaAvifSrcSet = !thumbnails && media.avif.map((variant) => `${variant.src} ${variant.width}w`).join(', ')
const mediaSrcSet = thumbnails
  ? thumbnails.map((variant, index) => `${variant.src} ${widths![index]}w`).join(', ')
  : media.optimized.map((variant) => `${variant.src} ${variant.width}w`).join(', ')
---

<picture>
  {mediaAvifSrcSet && <source type="image/avif" srcset={mediaAvifSrcSet} sizes={sizes} />}
  {mediaSrcSet && <source type="image/webp" srcset={mediaSrcSet} sizes={sizes} />}
  <img
    class={className}
    src={thumbnails ? thumbnails[0].src : src}
    alt={localizedAlt}
    {...(altEn !== undefined ? { 'data-alt-zh': alt, 'data-alt-en': altEn } : {})}
    decoding={decoding}
    fetchpriority={fetchpriority}
    loading={loading}
    width={media?.width}
    height={media?.height}
    sizes={sizes}
  />
</picture>
