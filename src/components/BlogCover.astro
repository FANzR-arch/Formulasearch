---
import { getBlogMedia } from '../data/blog-media'
import type { Locale } from '../lib/i18n'

interface Props {
  alt?: string
  altEn?: string
  className?: string
  decoding?: 'async' | 'auto' | 'sync'
  fetchpriority?: 'high' | 'low' | 'auto'
  loading?: 'eager' | 'lazy'
  locale?: Locale
  sizes: string
  src: string
}

const {
  alt = '',
  altEn,
  className,
  decoding = 'async',
  fetchpriority,
  loading,
  locale = 'zh',
  sizes,
  src,
} = Astro.props
const media = getBlogMedia(src)
const localizedAlt = locale === 'en' ? (altEn ?? alt) : alt
const mediaAvifSrcSet = media?.avif.map((variant) => `${variant.src} ${variant.width}w`).join(', ')
const mediaSrcSet = media?.optimized.map((variant) => `${variant.src} ${variant.width}w`).join(', ')
---

<picture>
  {mediaAvifSrcSet && <source type="image/avif" srcset={mediaAvifSrcSet} sizes={sizes} />}
  {mediaSrcSet && <source type="image/webp" srcset={mediaSrcSet} sizes={sizes} />}
  <img
    class={className}
    src={src}
    alt={localizedAlt}
    {...(altEn !== undefined ? { 'data-alt-zh': alt, 'data-alt-en': altEn } : {})}
    decoding={decoding}
    fetchpriority={fetchpriority}
    loading={loading}
    width={media?.width}
    height={media?.height}
    sizes={sizes}
  />
</picture>
