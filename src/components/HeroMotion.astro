---
export type HeroMotionVariant = 'blog' | 'projects' | 'skills' | 'resources' | 'photos' | 'architecture' | 'partners'

interface Props {
  variant: HeroMotionVariant
}

const { variant } = Astro.props

// Each section gets a quiet line drawing of its own subject, sharing one visual language: hairlines in
// the ink colour, one accent, a single slow motion. Generated from fixed seeds, so every build and both
// locales show the same picture.
const seeded = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296
}

// Resources: a shelf of book spines standing on the hero's bottom rule.
const shelfRandom = seeded(20261004)
const spines = variant === 'resources'
  ? Array.from({ length: 44 }, (_, index) => {
    const roll = shelfRandom()
    return {
      index,
      // Books come in runs separated by the occasional gap, like sections of a shelf.
      gap: roll < 0.1 ? 18 + Math.round(shelfRandom() * 22) : 1 + Math.round(shelfRandom() * 2),
      width: 9 + Math.round(shelfRandom() * 14),
      height: 46 + Math.round(shelfRandom() * 46),
      banded: shelfRandom() < 0.55,
      accent: shelfRandom() < 0.07,
      lean: shelfRandom() < 0.035 ? (shelfRandom() < 0.5 ? -1 : 1) * (6 + Math.round(shelfRandom() * 8)) : 0,
    }
  })
  : []

// Blog: a page of set text, greeked into word bars, with one more line being written behind a caret.
const textRandom = seeded(20261012)
const wordsFor = (target: number) => {
  const words: number[] = []
  let used = 0
  while (used < target) {
    const word = 14 + Math.round(textRandom() * 50)
    words.push(word)
    used += word + 7
  }
  return words
}
const manuscript = variant === 'blog'
  ? Array.from({ length: 6 }, (_, index) => wordsFor(index === 5 ? 170 : 300 + Math.round(textRandom() * 140)))
  : []
const writing = variant === 'blog' ? wordsFor(240) : []
const writingWidth = writing.reduce((sum, word) => sum + word + 7, 0) - 7

// Projects: a strip of film frames running slowly through a lit gate.
const frameWidths = [86, 64, 104, 72, 92, 60, 110, 78, 96]

// Skills: modules wired together; a signal travels the traces and lights each module as it arrives.
const nodes = [
  { x: 20, y: 10, w: 70, delay: 0 },
  { x: 130, y: 80, w: 84, delay: 1 },
  { x: 260, y: 10, w: 64, delay: 2 },
  { x: 360, y: 80, w: 76, delay: 3 },
  { x: 470, y: 10, w: 70, delay: 3 },
  { x: 520, y: 80, w: 60, delay: 4 },
]
const traces = [
  { d: 'M90 23H110V93H130', delay: 0 },
  { d: 'M214 93H236V23H260', delay: 1 },
  { d: 'M292 36V60H398V80', delay: 2 },
  { d: 'M324 23H470', delay: 2 },
  { d: 'M436 93H520', delay: 3 },
  { d: 'M505 36V58H550V80', delay: 3 },
]
const ports = traces.flatMap((trace) => {
  const numbers = trace.d.match(/-?\d+/g)!.map(Number)
  return [[numbers[0], numbers[1]]]
})

// Photos: prints pegged to a sagging line, as in a darkroom, each swaying on its own.
const lineY = (x: number) => {
  const t = x / 600
  return (1 - t) ** 2 * 14 + 2 * (1 - t) * t * 46 + t ** 2 * 18
}
const prints = [
  { x: 64, w: 52, h: 40 }, { x: 150, w: 44, h: 56 }, { x: 246, w: 60, h: 44 },
  { x: 348, w: 48, h: 40 }, { x: 446, w: 56, h: 46 }, { x: 540, w: 42, h: 54 },
].map((print, index) => ({ ...print, y: lineY(print.x), index, accent: index === 3 }))

// Architecture: an elevation drawn stroke by stroke on a ground line, with one dimension line.
const masses = [[30, 64, 96, 60], [140, 26, 62, 98], [214, 78, 128, 46], [356, 48, 58, 76], [428, 88, 116, 36], [552, 70, 40, 54]]
const facade = (x: number, y: number, w: number, h: number) => {
  const floors = Array.from({ length: Math.floor((h - 10) / 13) }, (_, row) => `M${x} ${y + 12 + row * 13}H${x + w}`)
  const bays = Array.from({ length: Math.floor((w - 6) / 14) }, (_, column) => `M${x + 10 + column * 14} ${y + 6}V${y + h}`)
  return [...floors, ...bays].join('')
}
const drawing = masses.map(([x, y, w, h], index) => ({ outline: `M${x} 124V${y}H${x + w}V124`, grid: facade(x, y, w, h), index }))

// Partners: two systems of orbiting nodes, joined by the recommendation that links them.
const orbit = (cx: number, cy: number, r: number, count: number, offset: number) =>
  Array.from({ length: count }, (_, index) => {
    const angle = offset + (index / count) * Math.PI * 2
    return { x: cx + Math.cos(angle) * r, y: cy + Math.sin(angle) * r }
  })
const systems = [
  { cx: 440, cy: 65, core: 7, rings: [{ r: 30, nodes: orbit(440, 65, 30, 3, 0.3), speed: 26 }, { r: 54, nodes: orbit(440, 65, 54, 4, 0.9), speed: -44 }] },
  { cx: 170, cy: 70, core: 5, rings: [{ r: 34, nodes: orbit(170, 70, 34, 3, 1.4), speed: 32 }] },
]
---

{variant === 'resources' && (
  <div class="hero-motion hero-motion--shelf" data-variant={variant} aria-hidden="true">
    <div class="hero-shelf">
      {spines.map((spine) => (
        <span
          class:list={['hero-shelf__spine', { 'hero-shelf__spine--accent': spine.accent, 'hero-shelf__spine--banded': spine.banded, 'hero-shelf__spine--leaning': spine.lean }]}
          style={`--i:${spine.index};--gap:${spine.gap}px;--w:${spine.width}px;--h:${spine.height}%;--lean:${spine.lean}deg`}
        />
      ))}
    </div>
  </div>
)}

{variant === 'blog' && (
  <div class="hero-motion hero-motion--figure" data-variant={variant} aria-hidden="true">
    <div class="hero-figure hero-manuscript">
      {manuscript.map((line) => (
        <div class="hero-manuscript__line">{line.map((word) => <i style={`width:${word}px`} />)}</div>
      ))}
      <div class="hero-manuscript__line hero-manuscript__line--writing" style={`--line:${writingWidth}px`}>
        <span class="hero-manuscript__ink">{writing.map((word) => <i style={`width:${word}px`} />)}</span>
        <b class="hero-manuscript__caret" />
      </div>
    </div>
  </div>
)}

{variant === 'projects' && (
  <div class="hero-motion hero-motion--figure hero-motion--reel" data-variant={variant} aria-hidden="true">
    <div class="hero-figure hero-reel">
      <div class="hero-reel__track">
        {[...frameWidths, ...frameWidths].map((frameWidth, index) => (
          <span class="hero-reel__frame" style={`--w:${frameWidth}px`} data-copy={index >= frameWidths.length ? '' : undefined} />
        ))}
      </div>
    </div>
  </div>
)}

{variant === 'skills' && (
  <div class="hero-motion hero-motion--figure" data-variant={variant} aria-hidden="true">
    <svg class="hero-figure hero-circuit" viewBox="0 0 600 110" preserveAspectRatio="xMaxYMid meet">
      {traces.map((trace) => <path class="hero-circuit__trace" d={trace.d} />)}
      {traces.map((trace) => <path class="hero-circuit__signal" d={trace.d} pathLength="100" style={`--delay:${trace.delay}s`} />)}
      {ports.map(([x, y]) => <circle class="hero-circuit__port" cx={x} cy={y} r="2" />)}
      {nodes.map((node) => (
        <rect class="hero-circuit__node" x={node.x} y={node.y} width={node.w} height="26" rx="6" style={`--delay:${node.delay}s`} />
      ))}
    </svg>
  </div>
)}

{variant === 'photos' && (
  <div class="hero-motion hero-motion--figure" data-variant={variant} aria-hidden="true">
    <svg class="hero-figure hero-prints" viewBox="0 0 600 120" preserveAspectRatio="xMaxYMid meet">
      <path class="hero-prints__line" d="M0 14Q300 46 600 18" />
      {prints.map((print) => (
        <g class:list={['hero-prints__print', { 'hero-prints__print--accent': print.accent }]} style={`--i:${print.index};transform-origin:${print.x}px ${print.y.toFixed(1)}px`}>
          <rect class="hero-prints__paper" x={print.x - print.w / 2} y={print.y + 3} width={print.w} height={print.h} rx="1" />
          <rect class="hero-prints__image" x={print.x - print.w / 2 + 4} y={print.y + 7} width={print.w - 8} height={print.h - 14} />
          <rect class="hero-prints__peg" x={print.x - 2.5} y={print.y - 5} width="5" height="11" rx="1" />
        </g>
      ))}
    </svg>
  </div>
)}

{variant === 'architecture' && (
  <div class="hero-motion hero-motion--figure" data-variant={variant} aria-hidden="true">
    <svg class="hero-figure hero-elevation" viewBox="0 0 600 130" preserveAspectRatio="xMaxYMid meet">
      <path class="hero-elevation__ground" d="M0 124H600" pathLength="1" />
      {drawing.map((part) => <path class="hero-elevation__grid" d={part.grid} style={`--i:${part.index}`} />)}
      {drawing.map((part) => <path class="hero-elevation__outline" d={part.outline} pathLength="1" style={`--i:${part.index}`} />)}
      <path class="hero-elevation__dimension" d="M140 12H202M140 7V17M202 7V17" pathLength="1" />
    </svg>
  </div>
)}

{variant === 'partners' && (
  <div class="hero-motion hero-motion--figure" data-variant={variant} aria-hidden="true">
    <svg class="hero-figure hero-orbits" viewBox="0 0 600 130" preserveAspectRatio="xMaxYMid meet">
      <path class="hero-orbits__link" d="M177 62C260 6 360 6 433 58" />
      <path class="hero-orbits__link hero-orbits__link--flow" d="M177 62C260 6 360 6 433 58" pathLength="100" />
      {systems.map((system) => (
        <g>
          {system.rings.map((ring) => (
            <g class="hero-orbits__ring" style={`transform-origin:${system.cx}px ${system.cy}px;--period:${Math.abs(ring.speed)}s;--direction:${ring.speed < 0 ? 'reverse' : 'normal'}`}>
              <circle class="hero-orbits__path" cx={system.cx} cy={system.cy} r={ring.r} />
              {ring.nodes.map((node) => <path class="hero-orbits__spoke" d={`M${system.cx} ${system.cy}L${node.x.toFixed(1)} ${node.y.toFixed(1)}`} />)}
              {ring.nodes.map((node) => <circle class="hero-orbits__node" cx={node.x.toFixed(1)} cy={node.y.toFixed(1)} r="3.2" />)}
            </g>
          ))}
          <circle class="hero-orbits__core" cx={system.cx} cy={system.cy} r={system.core} />
        </g>
      ))}
    </svg>
  </div>
)}

<style>
  .hero-motion {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    color: var(--ink);
    opacity: .5;
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .hero-motion { opacity: .62; }

  /* ---------- Resources: shelf ----------
     Hairline spines standing on the hero's bottom rule, fading out toward the title. A reading lamp
     drifts along the shelf; as it passes, each spine brightens and lifts a hair, one after another. */
  .hero-motion--shelf {
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 16%, transparent), transparent) no-repeat;
    background-size: 34% 150%;
    background-position: 30% 100%;
    animation: hero-shelf-lamp 14s ease-in-out infinite alternate;
  }
  .hero-shelf {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    height: 74%;
    mask-image: linear-gradient(90deg, transparent, #000 38%);
  }
  .hero-shelf__spine {
    flex: none;
    width: var(--w);
    height: var(--h);
    margin-left: var(--gap);
    border: 1px solid color-mix(in oklab, currentColor 46%, transparent);
    border-bottom: 0;
    border-radius: 1.5px 1.5px 0 0;
    transform-origin: bottom center;
    animation: hero-shelf-glint 14s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * 180ms - 14s);
  }
  /* Two ruled bands near the head, like the lines printed on cloth bindings. */
  .hero-shelf__spine--banded {
    background: linear-gradient(transparent 11%, color-mix(in oklab, currentColor 34%, transparent) 11% calc(11% + 1px), transparent 0, transparent 16%, color-mix(in oklab, currentColor 34%, transparent) 16% calc(16% + 1px), transparent 0);
  }
  .hero-shelf__spine--accent {
    border-color: color-mix(in oklab, var(--accent) 70%, transparent);
    background-color: color-mix(in oklab, var(--accent) 16%, transparent);
  }
  .hero-shelf__spine--leaning {
    transform: rotate(var(--lean));
    transform-origin: bottom right;
    animation: none;
  }
  @keyframes hero-shelf-lamp {
    from { background-position: 30% 100%; }
    to { background-position: 105% 100%; }
  }
  @keyframes hero-shelf-glint {
    0%, 38%, 62%, 100% { opacity: .55; translate: 0 0; }
    50% { opacity: 1; translate: 0 -3px; }
  }

  /* ---------- Shared frame for the figures that sit in the empty band above the copy ---------- */
  /* The empty band between the fixed navigation and the title row. */
  .hero-figure {
    position: absolute;
    top: 30%;
    right: 0;
    width: min(56%, 640px);
    height: 30%;
    mask-image: linear-gradient(90deg, transparent, #000 34%), linear-gradient(#000 70%, transparent);
    mask-composite: intersect;
  }

  /* ---------- Blog: manuscript ---------- */
  .hero-manuscript { display: grid; align-content: start; gap: 13px; }
  .hero-manuscript__line { position: relative; display: flex; gap: 7px; height: 3px; }
  .hero-manuscript__line i,
  .hero-manuscript__ink i {
    flex: none;
    height: 3px;
    border-radius: 2px;
    background: color-mix(in oklab, currentColor 40%, transparent);
  }
  .hero-manuscript__ink {
    display: flex;
    gap: 7px;
    clip-path: inset(-2px 100% -2px 0);
    animation: hero-write 9s cubic-bezier(.45, 0, .4, 1) infinite;
  }
  .hero-manuscript__ink i { background: color-mix(in oklab, currentColor 70%, transparent); }
  .hero-manuscript__caret {
    position: absolute;
    top: -6px;
    left: 0;
    width: 1.5px;
    height: 15px;
    background: var(--accent);
    animation: hero-caret-travel 9s cubic-bezier(.45, 0, .4, 1) infinite, hero-caret-blink 1s steps(1) infinite;
  }
  @keyframes hero-write {
    0% { clip-path: inset(-2px 100% -2px 0); opacity: 1; }
    58%, 86% { clip-path: inset(-2px 0 -2px 0); opacity: 1; }
    96%, 100% { clip-path: inset(-2px 0 -2px 0); opacity: 0; }
  }
  @keyframes hero-caret-travel {
    0% { translate: 0 0; opacity: 1; }
    58%, 86% { translate: calc(var(--line) + 4px) 0; opacity: 1; }
    96% { translate: calc(var(--line) + 4px) 0; opacity: 0; }
    100% { translate: 0 0; opacity: 0; }
  }
  @keyframes hero-caret-blink { 50% { visibility: hidden; } }

  /* ---------- Projects: film strip through a lit gate ---------- */
  .hero-motion--reel {
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 18%, transparent), transparent) no-repeat;
    background-size: 22% 70%;
    background-position: 74% 22%;
  }
  .hero-reel { overflow: hidden; }
  .hero-reel__track {
    display: flex;
    width: max-content;
    padding-block: 14px;
    /* Sprocket holes along both edges, moving with the film. */
    background:
      radial-gradient(circle, color-mix(in oklab, currentColor 45%, transparent) 1.3px, transparent 1.7px) 0 3px / 12px 8px repeat-x,
      radial-gradient(circle, color-mix(in oklab, currentColor 45%, transparent) 1.3px, transparent 1.7px) 0 calc(100% - 3px) / 12px 8px repeat-x;
    animation: hero-reel-run 42s linear infinite;
  }
  .hero-reel__frame {
    --corner: color-mix(in oklab, currentColor 62%, transparent);
    flex: none;
    width: var(--w);
    height: 58px;
    margin-right: 12px;
    border-radius: 2px;
    /* Crop marks only, so each frame reads as a viewfinder rather than a box. */
    background:
      linear-gradient(var(--corner), var(--corner)) top left / 9px 1px,
      linear-gradient(var(--corner), var(--corner)) top left / 1px 9px,
      linear-gradient(var(--corner), var(--corner)) top right / 9px 1px,
      linear-gradient(var(--corner), var(--corner)) top right / 1px 9px,
      linear-gradient(var(--corner), var(--corner)) bottom left / 9px 1px,
      linear-gradient(var(--corner), var(--corner)) bottom left / 1px 9px,
      linear-gradient(var(--corner), var(--corner)) bottom right / 9px 1px,
      linear-gradient(var(--corner), var(--corner)) bottom right / 1px 9px,
      color-mix(in oklab, currentColor 5%, transparent);
    background-repeat: no-repeat;
  }
  @keyframes hero-reel-run { to { transform: translateX(-50%); } }

  /* ---------- Skills: wired modules ---------- */
  .hero-circuit { overflow: visible; }
  .hero-circuit__trace {
    fill: none;
    stroke: color-mix(in oklab, currentColor 42%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .hero-circuit__signal {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 9 200;
    stroke-dashoffset: 9;
    vector-effect: non-scaling-stroke;
    animation: hero-signal 6s cubic-bezier(.5, 0, .5, 1) infinite;
    animation-delay: var(--delay);
  }
  .hero-circuit__port { fill: color-mix(in oklab, currentColor 55%, transparent); }
  .hero-circuit__node {
    fill: color-mix(in oklab, var(--paper) 70%, transparent);
    stroke: color-mix(in oklab, currentColor 50%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    animation: hero-node-lit 6s ease-out infinite;
    animation-delay: var(--delay);
  }
  @keyframes hero-signal {
    0% { stroke-dashoffset: 9; opacity: 1; }
    16.6% { stroke-dashoffset: -100; opacity: 1; }
    17.5%, 100% { stroke-dashoffset: -100; opacity: 0; }
  }
  @keyframes hero-node-lit {
    0%, 100% { stroke: color-mix(in oklab, currentColor 50%, transparent); }
    4% { stroke: var(--accent); fill: color-mix(in oklab, var(--accent) 16%, var(--paper)); }
    30% { stroke: color-mix(in oklab, currentColor 50%, transparent); fill: color-mix(in oklab, var(--paper) 70%, transparent); }
  }

  /* ---------- Photos: prints on a line ---------- */
  .hero-prints { overflow: visible; }
  .hero-prints__line { fill: none; stroke: color-mix(in oklab, currentColor 40%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .hero-prints__print {
    transform-box: view-box;
    animation: hero-print-sway calc(5.5s + var(--i) * .7s) ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.3s);
  }
  .hero-prints__paper { fill: color-mix(in oklab, var(--paper) 80%, transparent); stroke: color-mix(in oklab, currentColor 50%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .hero-prints__image { fill: color-mix(in oklab, currentColor 9%, transparent); }
  .hero-prints__peg { fill: color-mix(in oklab, currentColor 55%, transparent); }
  .hero-prints__print--accent .hero-prints__paper { stroke: var(--accent); }
  .hero-prints__print--accent .hero-prints__image { fill: color-mix(in oklab, var(--accent) 18%, transparent); }
  @keyframes hero-print-sway {
    from { transform: rotate(-2.4deg); }
    to { transform: rotate(2.4deg); }
  }

  /* ---------- Architecture: an elevation drawn stroke by stroke ---------- */
  /* The buildings stand on their ground line, so this figure only fades toward the title, not downward. */
  .hero-motion[data-variant='architecture'] .hero-figure { mask-image: linear-gradient(90deg, transparent, #000 34%); }
  .hero-elevation { overflow: visible; }
  .hero-elevation path { fill: none; stroke-linecap: square; vector-effect: non-scaling-stroke; }
  .hero-elevation__ground { stroke: color-mix(in oklab, currentColor 55%, transparent); stroke-width: 1; }
  .hero-elevation__outline {
    stroke: color-mix(in oklab, currentColor 62%, transparent);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draft 14s cubic-bezier(.45, 0, .4, 1) infinite;
    animation-delay: calc(var(--i) * .35s);
  }
  .hero-elevation__grid {
    stroke: color-mix(in oklab, currentColor 22%, transparent);
    stroke-width: 1;
    opacity: 0;
    animation: hero-draft-fill 14s ease-in-out infinite;
    animation-delay: calc(var(--i) * .35s);
  }
  .hero-elevation__dimension {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draft 14s cubic-bezier(.45, 0, .4, 1) infinite;
    animation-delay: 2.4s;
  }
  @keyframes hero-draft {
    0% { stroke-dashoffset: 1; opacity: 1; }
    22%, 80% { stroke-dashoffset: 0; opacity: 1; }
    92%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes hero-draft-fill {
    0%, 18% { opacity: 0; }
    32%, 80% { opacity: 1; }
    92%, 100% { opacity: 0; }
  }

  /* ---------- Partners: orbiting systems joined by a link ---------- */
  .hero-orbits { overflow: visible; }
  .hero-orbits__ring { transform-box: view-box; animation: hero-orbit var(--period) linear infinite var(--direction); }
  .hero-orbits__path { fill: none; stroke: color-mix(in oklab, currentColor 26%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .hero-orbits__spoke { fill: none; stroke: color-mix(in oklab, currentColor 18%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .hero-orbits__node { fill: color-mix(in oklab, var(--paper) 70%, transparent); stroke: color-mix(in oklab, currentColor 60%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .hero-orbits__core { fill: color-mix(in oklab, var(--accent) 22%, var(--paper)); stroke: var(--accent); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .hero-orbits__link { fill: none; stroke: color-mix(in oklab, currentColor 30%, transparent); stroke-width: 1; stroke-dasharray: 3 5; vector-effect: non-scaling-stroke; }
  .hero-orbits__link--flow { stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 8 100; stroke-dashoffset: 8; animation: hero-link 6s cubic-bezier(.5, 0, .5, 1) infinite; }
  @keyframes hero-orbit { to { transform: rotate(360deg); } }
  @keyframes hero-link {
    0% { stroke-dashoffset: 8; opacity: 1; }
    40% { stroke-dashoffset: -100; opacity: 1; }
    41%, 100% { stroke-dashoffset: -100; opacity: 0; }
  }

  @media (max-width: 820px) {
    .hero-shelf { height: 62%; }
    .hero-figure { top: 24%; width: 100%; height: 34%; }
  }
  /* On phones the title and description fill the band; the figures would sit on the copy, so they step aside. */
  @media (max-width: 620px) {
    .hero-motion--figure { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-motion,
    .hero-motion *,
