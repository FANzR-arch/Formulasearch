---
export type HeroMotionVariant = 'blog' | 'projects' | 'skills' | 'lab'

interface Props {
  variant: HeroMotionVariant
}

const { variant } = Astro.props
---

<div class="hero-motion" data-variant={variant} aria-hidden="true">
  <svg viewBox="0 0 1180 360" preserveAspectRatio="none">
    <path class="hero-motion__trail hero-motion__trail--one" d="M-20 274C152 338 250 79 413 128s165 207 338 113 243-45 449 30" />
    <path class="hero-motion__trail hero-motion__trail--two" d="M-30 312C168 181 238 307 389 229S628 43 769 132s230 137 451 29" />
    <path class="hero-motion__trail hero-motion__trail--three" d="M-40 88c214 8 252 169 413 146S584 36 747 77s226 207 493 145" />
    <path class="hero-motion__trail hero-motion__trail--four" d="M-60 182C113 82 255 222 391 177s236-118 371-31 242 117 499-15" />
    <circle class="hero-motion__node hero-motion__node--one" cx="27%" cy="45%" r="4" />
    <circle class="hero-motion__node hero-motion__node--two" cx="63%" cy="66%" r="3" />
    <circle class="hero-motion__node hero-motion__node--three" cx="84%" cy="31%" r="3.5" />
  </svg>
</div>

<style>
  .hero-motion {
    position: absolute;
    z-index: 0;
    inset: -8% -4%;
    overflow: hidden;
    color: var(--ink);
    opacity: .24;
    pointer-events: none;
    transform-origin: center;
    animation: hero-motion-breathe 8s cubic-bezier(.45, 0, .55, 1) infinite alternate;
  }
  .hero-motion svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .hero-motion__trail {
    fill: none;
    stroke: currentColor;
    stroke-dasharray: 11 13;
    stroke-linecap: round;
    stroke-width: 1.45;
    vector-effect: non-scaling-stroke;
    animation: hero-motion-drift 12s linear infinite;
  }
  .hero-motion__trail--two {
    stroke: var(--accent);
    stroke-dasharray: 5 16;
    stroke-width: 1.7;
    animation-duration: 17s;
    animation-direction: reverse;
  }
  .hero-motion__trail--three { animation-duration: 21s; }
  .hero-motion__trail--four {
    opacity: .72;
    stroke-dasharray: 2 18;
    animation-duration: 14s;
    animation-direction: reverse;
  }
  .hero-motion__node {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: center;
    animation: hero-motion-pulse 3.6s ease-in-out infinite;
  }
  .hero-motion__node--two { animation-delay: -1.2s; }
  .hero-motion__node--three { animation-delay: -2.4s; }
  :global(:root[data-theme='dark']) .hero-motion { opacity: .31; }
  @keyframes hero-motion-drift { to { stroke-dashoffset: -288; } }
  @keyframes hero-motion-breathe {
    from { transform: translate3d(-1.2%, -.8%, 0) scale(1.02) rotate(-.15deg); }
    to { transform: translate3d(1.2%, .8%, 0) scale(1.045) rotate(.15deg); }
  }
  @keyframes hero-motion-pulse {
    0%, 100% { opacity: .18; transform: scale(.55); }
    50% { opacity: .95; transform: scale(1.35); }
  }
  @media (max-width: 820px) {
    .hero-motion { inset: -4% -24%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-motion,
    .hero-motion__trail,
    .hero-motion__node { animation: none; }
    .hero-motion { opacity: .14; transform: none; }
  }
</style>
