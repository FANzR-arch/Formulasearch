---
interface Props {
  active: 'latest' | 'series' | 'archive'
}

const { active } = Astro.props
const items = [
  { id: 'latest', href: '/blog', label: 'Latest' },
  { id: 'series', href: '/blog/series', label: 'Series' },
  { id: 'archive', href: '/blog/archive', label: 'Archive' },
] as const
---

<nav class="blog-section-nav" aria-label="Blog 页面">
  {items.map((item) => (
    <a class:list={{ 'is-active': item.id === active }} href={item.href} aria-current={item.id === active ? 'page' : undefined}>
      {item.label}
    </a>
  ))}
</nav>
