---
import LocalizedText from './LocalizedText.astro'
import Icon from './icon-system/Icon.astro'
import PageHero from './PageHero.astro'
import ProjectCard from './ProjectCard.astro'
import ProjectShowcase from './ProjectShowcase.astro'
import type { CatalogPage, CatalogSection } from '../data/catalog'
import type { Locale } from '../lib/i18n'

interface Props {
  page: CatalogPage
  motionVariant: 'projects' | 'skills' | 'lab'
  sections: CatalogSection[]
  locale?: Locale
}

const { motionVariant, page, sections, locale = 'zh' } = Astro.props
const projectRoot = locale === 'en' ? '/en/projects' : '/projects'
---

<PageHero title={page.heading} description={page.intro} motionVariant={motionVariant} />
{sections.length > 0 && (
  <div class="catalog-sections">
    {sections.map((section, index) => section.presentation === 'projects' ? (
      <section id={section.id} class="project-group" data-site-reveal data-site-reveal-delay={String((index % 2) * 70)}>
        <header class="project-group__heading">
          <h2><LocalizedText {...section.title} /></h2>
          <p><LocalizedText {...section.description} /></p>
        </header>
        {section.items.length === 1 && section.items[0].showcase ? (
          <ProjectShowcase href={`${projectRoot}/${section.items[0].id}`} item={section.items[0]} locale={locale} />
        ) : (
          <div class="project-card-grid">
            {section.items.map((item, itemIndex) => <ProjectCard href={`${projectRoot}/${item.id}`} item={item} eager={index === 0 && itemIndex === 0} locale={locale} />)}
          </div>
        )}
      </section>
    ) : section.presentation === 'skill-gallery' ? (
      <section id={section.id} class="skill-feature" data-site-reveal data-site-reveal-delay={String((index % 2) * 70)}>
        <header class="skill-feature__header">
          <div class="skill-feature__title">
            <span class="skill-feature__eyebrow">Featured collection · {section.label}</span>
            <h2><LocalizedText {...section.title} /></h2>
            <p><LocalizedText {...section.description} /></p>
          </div>
          <div class="skill-feature__summary">
            <p><LocalizedText {...section.summary} /></p>
            <a class="skill-feature__repository" href={section.repositoryUrl} target="_blank" rel="noopener noreferrer">
              <span>{locale === 'zh' ? '查看完整仓库与安装说明' : 'Repository and installation'}</span>
              <Icon name="catalog-external" role="meta" />
            </a>
          </div>
        </header>
        <dl class="skill-feature__facts">
          {section.facts.map((fact) => (
            <div>
              <dt><LocalizedText {...fact.label} /></dt>
              <dd><LocalizedText {...fact.value} /></dd>
            </div>
          ))}
        </dl>
        <div class="skill-gallery__stage">
          <ul id={`skill-gallery-${section.id}`} class="skill-gallery" data-skill-gallery aria-roledescription={locale === 'zh' ? '卡片组' : 'card stack'} aria-label={locale === 'zh' ? 'Phil Design Skills 风格样例' : 'Phil Design Skills style previews'}>
            {section.gallery.map((item, itemIndex) => (
              <li data-skill-card data-skill-title={item.title[locale]}>
                <figure class="skill-gallery__item">
                  <div
                    class="skill-gallery__drag"
                    data-skill-drag
                    role="button"
                    tabindex="0"
                    aria-label={locale === 'zh' ? `拖动或轻点切换：${item.title.zh}` : `Drag or tap to cycle: ${item.title.en}`}
                  >
                    <img src={item.image} alt={item.imageAlt[locale]} loading={itemIndex < 3 ? 'eager' : 'lazy'} decoding="async" />
                  </div>
                  <figcaption>
                    <a class="skill-gallery__open" data-skill-open href={item.externalUrl} target="_blank" rel="noopener noreferrer">
                      <span><LocalizedText {...item.title} /></span>
                      <Icon name="catalog-external" role="meta" />
                    </a>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
          <div class="skill-gallery__toolbar">
            <button
              class="skill-gallery__shuffle"
              type="button"
              aria-controls={`skill-gallery-${section.id}`}
              aria-label={locale === 'zh' ? '洗牌' : 'Shuffle'}
              title={locale === 'zh' ? '洗牌' : 'Shuffle'}
              data-skill-shuffle
              data-status-zh="已完成第 {count} 次洗牌"
              data-status-en="Shuffle {count} complete"
            >
              <Icon name="skills-shuffle" role="control" />
            </button>
            <p class="visually-hidden" role="status" aria-live="polite" data-skill-shuffle-status></p>
          </div>
        </div>
      </section>
    ) : section.presentation === 'skill-project' ? (
      <section id={section.id} class="skill-project" data-site-reveal data-site-reveal-delay={String((index % 2) * 70)}>
        <a class="skill-project__media" href={section.repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label={locale === 'zh' ? `查看 ${section.title.zh} 仓库` : `Visit the ${section.title.en} repository`}>
          <img class="skill-project__cover skill-project__cover--light" src={section.cover.light} alt={section.coverAlt[locale]} loading="lazy" decoding="async" />
          <img class="skill-project__cover skill-project__cover--dark" src={section.cover.dark} alt="" aria-hidden="true" loading="lazy" decoding="async" />
        </a>
        <div class="skill-project__content">
          <span class="skill-project__eyebrow"><LocalizedText {...section.tag} /></span>
          <h2><LocalizedText {...section.title} /></h2>
          <p><LocalizedText {...section.description} /></p>
          <a class="skill-project__repository" href={section.repositoryUrl} target="_blank" rel="noopener noreferrer">
            <span>{locale === 'zh' ? '查看项目与使用说明' : 'Project and usage guide'}</span>
            <Icon name="catalog-external" role="meta" />
          </a>
        </div>
      </section>
    ) : <section id={section.id} class:list={["catalog-section", { "catalog-section--media": section.image, "catalog-section--detailed": section.items.some((item) => item.description) }]} data-site-reveal data-site-reveal-delay={String((index % 2) * 70)}>
      {section.image && section.imageAlt && (
        <figure class="catalog-section__media">
          <img src={section.image} alt={section.imageAlt[locale]} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </figure>
      )}
      <div class="catalog-section__content">
        <h2><LocalizedText {...section.title} /></h2>
        <p><LocalizedText {...section.description} /></p>
        <ul>{section.items.map((item) => <li>{item.externalUrl ? (
          <a class="catalog-section__external" href={item.externalUrl} target="_blank" rel="noopener noreferrer">
            <span class="catalog-section__item-copy">
              {item.tag && <small><LocalizedText {...item.tag} /></small>}
              <strong><LocalizedText zh={item.zh} en={item.en} /></strong>
              {item.description && <span><LocalizedText {...item.description} /></span>}
            </span>
            <Icon name="catalog-external" role="meta" />
          </a>
        ) : <span class="catalog-section__item-copy">
          {item.tag && <small><LocalizedText {...item.tag} /></small>}
          <strong><LocalizedText zh={item.zh} en={item.en} /></strong>
          {item.description && <span><LocalizedText {...item.description} /></span>}
        </span>}</li>)}</ul>
      </div>
    </section>)}
  </div>
)}

<script is:inline src="/scripts/project-showcase.js"></script>
<script is:inline src="/scripts/skill-gallery.js"></script>
