---
import Icon from './icon-system/Icon.astro'
import LocalizedText from './LocalizedText.astro'
import type { CatalogSection } from '../data/catalog'
import type { Locale } from '../lib/i18n'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  id: string
  videos: NonNullable<Extract<CatalogSection, { presentation: 'projects' }>['videos']>
  locale?: Locale
  layout?: 'grid' | 'compact' | 'filmstrip' | 'featured'
}

const { id, videos, locale = 'zh', layout = 'grid' } = Astro.props
const isCompact = layout === 'compact' || layout === 'filmstrip'
const posters = import.meta.glob<ImageMetadata>('/public/uploads/projects/**/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' })
const preparedVideos = await Promise.all(videos.map(async (video) => {
  const source = posters[`/public${video.poster}`]
  if (!source) throw new Error(`Missing video poster: ${video.poster}`)
  // Keep lightweight previews, with a larger poster for the lead personal film.
  const previewWidth = layout === 'filmstrip' ? Math.ceil(560 * video.width / video.height) : isCompact ? 480 : 1200
  const width = Math.min(source.width, previewWidth)
  const poster = await getImage({ src: source, width, format: 'webp', quality: 80 })
  return { ...video, poster: poster.src }
}))
---

<div class="project-videos__stage" data-video-collection={isCompact ? '' : undefined}>
<div id={id} class:list={['project-videos', { 'project-card-grid': layout === 'grid', 'project-videos--compact': isCompact, 'project-videos--featured': layout === 'featured' }]}>
  {preparedVideos.map((video) => (
    <article class:list={['project-video', { 'project-video--filmstrip': layout === 'filmstrip', 'project-video--wide': video.width >= video.height }]} style={`--video-ratio: ${video.width / video.height}`}>
      <div class="project-video__player" data-video-player>
      <video controls playsinline preload="none" poster={video.poster} width={video.width} height={video.height} style={`aspect-ratio: ${video.width} / ${video.height}`} aria-label={video.title[locale]} data-aria-zh={video.title.zh} data-aria-en={video.title.en}>
        <source src={video.src} type="video/mp4" />
        {video.sourceUrl ? <a href={video.sourceUrl} target="_blank" rel="noopener noreferrer"><LocalizedText zh="在 X 查看视频" en="Watch on X" /></a> : <LocalizedText zh="当前浏览器不支持视频播放。" en="Your browser does not support video playback." />}
      </video>
      <button type="button" class="project-video__start" data-video-start hidden aria-label={locale === 'zh' ? `播放：${video.title.zh}` : `Play: ${video.title.en}`} data-aria-zh={`播放：${video.title.zh}`} data-aria-en={`Play: ${video.title.en}`}>
        <img src={video.poster} alt="" width={video.width} height={video.height} loading="lazy" decoding="async" />
        <span class="project-video__play-icon"><Icon name="video-play" role="control" /></span>
      </button>
      <div class="project-video__error" data-video-error hidden role="status">
        <LocalizedText zh="视频暂时无法加载，请检查网络后重试。" en="Video unavailable. Check your connection and try again." />
        <button type="button" data-video-retry><LocalizedText zh="重新加载" en="Retry" /></button>
      </div>
      </div>
      <div class:list={['project-video__copy', { 'project-video__copy--compact': isCompact }]}>
        {video.category && <p class="project-video__category"><LocalizedText {...video.category} /></p>}
        {layout === 'featured' ? <h2><LocalizedText {...video.title} /></h2> : layout === 'filmstrip' ? <h4><LocalizedText {...video.title} /></h4> : <h3><LocalizedText {...video.title} /></h3>}
        {video.description && <p class="project-video__description"><LocalizedText {...video.description} /></p>}
        {video.sourceUrl && <a class="project-video__source" href={video.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={locale === 'zh' ? '查看 X 原帖' : 'View original post on X'} data-aria-zh="查看 X 原帖" data-aria-en="View original post on X">
          X
        </a>}
      </div>
    </article>
  ))}
</div>

{isCompact && <button class="project-videos__more" type="button" data-video-more hidden aria-expanded="false" aria-controls={id}>
  <span class="project-videos__expand"><LocalizedText zh="展开更多" en="Show more" /></span>
  <span class="project-videos__collapse"><LocalizedText zh="收起" en="Show less" /></span>
  <Icon name="nav-chevron" role="control" />
</button>}
</div>

<script is:inline src="/scripts/project-videos.js"></script>

<style>
  .project-video { min-width: 0; }
  .project-videos__stage { position: relative; min-width: 0; }
  .project-videos__more { display: flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 16px; padding: 8px 0; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: var(--text-sm); cursor: pointer; }
  .project-videos__more:hover { color: var(--ink); }
  .project-videos__more[aria-expanded='false'] .project-videos__collapse,
  .project-videos__more[aria-expanded='true'] .project-videos__expand { display: none; }
  .project-videos__more[aria-expanded='true'] :global(.icon) { transform: rotate(180deg); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .project-video__player { position: relative; }
  .project-video__player[data-initialized]:not([data-started]) video { visibility: hidden; }
  .project-video__start { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 1px solid var(--hairline); background: var(--media-placeholder); cursor: pointer; }
  .project-video__start img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .project-video__play-icon { position: absolute; left: 12px; bottom: 12px; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgb(255 255 255 / .3); background: rgb(0 0 0 / .6); color: #fff; }
  .project-video__start:hover .project-video__play-icon { background: rgb(0 0 0 / .85); }
  [hidden] { display: none !important; }
  .project-video__error { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12px; padding: 16px; text-align: center; font-size: var(--text-sm); background: var(--paper); color: var(--ink); }
  .project-video__error button { padding: 8px 12px; border: 1px solid var(--hairline); border-radius: 6px; color: inherit; background: transparent; cursor: pointer; }
  .project-videos--compact { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 24px clamp(16px, 2vw, 24px); max-width: 100%; }
  .project-videos--compact .project-video { flex: 0 0 auto; width: min(100%, clamp(160px, 20vw, 240px)); }
  .project-videos--compact .project-video--filmstrip { width: min(100%, calc(clamp(180px, 23vw, 280px) * var(--video-ratio))); }
  @media (max-width: 600px) {
    .project-videos--compact { column-gap: 16px; }
    .project-videos--compact .project-video { width: calc((100% - 16px) / 2); }
    .project-videos--compact .project-video--wide { width: 100%; }
  }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; background: var(--media-placeholder); border: 1px solid var(--hairline); }
  .project-video__copy { padding-top: 20px; }
  .project-video__category { margin: 0 0 8px; color: var(--muted); font-size: var(--text-2xs); }
  h3, h4 { margin: 0; font-size: var(--text-lg); font-weight: var(--weight-medium); line-height: 1.4; }
  .project-video__copy--compact { padding-top: 10px; }
  .project-video__copy--compact :is(h3, h4) { font-size: var(--text-sm); }
  .project-videos--featured .project-video { display: grid; grid-template-columns: minmax(0, .6fr) minmax(0, 1.4fr); align-items: center; gap: clamp(24px, 5vw, 72px); }
  .project-videos--featured .project-video__player { grid-column: 2; grid-row: 1; }
  .project-videos--featured .project-video__copy { grid-column: 1; grid-row: 1; min-width: 0; padding: 0; container-type: inline-size; }
  .project-videos--featured h2 { margin: 0; font-size: clamp(44px, 6vw, 80px); line-height: 1.12; font-weight: 600; overflow-wrap: anywhere; }
  :global(html[data-locale='en']) .project-videos--featured h2 { font-size: min(80px, 18cqi); }
  .project-videos--featured .project-video__play-icon { width: 52px; height: 52px; left: 20px; bottom: 20px; }
  @media (max-width: 700px) {
    .project-videos--featured .project-video { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .project-videos--featured .project-video__copy { grid-column: 1; grid-row: 1; }
    .project-videos--featured .project-video__player { grid-column: 1; grid-row: 2; }
  }
  .project-video__description { margin: 12px 0 16px; color: var(--muted); font-size: var(--text-sm); line-height: 1.7; }
  .project-video__source { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-xs); }
  .project-video__source:hover { color: var(--accent); }
</style>
