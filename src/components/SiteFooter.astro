---
import LocalizedText from './LocalizedText.astro'
import { siteConfig } from '../data/site-config'
import { siteRoutes } from '../data/site-routes'
import { uiCopy } from '../data/ui-copy'

interface Props {
  variant?: 'catalog' | 'site'
}

const { variant = 'site' } = Astro.props
---

<footer class={variant === 'catalog' ? 'catalog-footer' : 'site-footer'}>
  <span>© {new Date().getFullYear()} {siteConfig.name}</span>
  <a href={siteRoutes.home}><LocalizedText {...uiCopy.common.returnHome} /></a>
</footer>
