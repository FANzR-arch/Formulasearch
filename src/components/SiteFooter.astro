---
import Icon from './icon-system/Icon.astro'
import LocalizedText from './LocalizedText.astro'
import { primaryNavigation } from '../data/navigation'
import { getLocalizedRoute, siteRoutes } from '../data/site-routes'
import { uiCopy } from '../data/ui-copy'
import { homeContent } from '../lib/home-content'
import { getLocalizedValue, type Locale } from '../lib/i18n'

interface Props {
  locale?: Locale
  showHomeLink?: boolean
  variant?: 'catalog' | 'site'
}

const { locale = 'zh', showHomeLink = true, variant = 'site' } = Astro.props
const localized = (zh: string, en: string) => getLocalizedValue({ zh, en }, locale)
const localizedRoute = (route: string) => getLocalizedRoute(route, locale)
const { email, social } = homeContent.zh
const year = new Date().getFullYear()
const maxItemsPerColumn = 6
---

{showHomeLink ? (
  <footer class="site-footer-rich" data-site-reveal>
    <div class="site-footer-rich__inner">
      <div class="site-footer-rich__top">
        <div class="site-footer-rich__brand">
          <p class="site-footer-rich__name">
            <a href={localizedRoute(siteRoutes.home)}>Phil Carlos</a>
          </p>
          <p class="site-footer-rich__tag"><LocalizedText zh="构建者，设计师。用 AI 做影像、工具和网站，也把做的过程写下来。" en="Builder and designer. I make films, tools and websites with AI, and write down how." /></p>
          <div class="site-footer-rich__contact">
            <a class="site-footer-rich__chip" href={social.url} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
              <img class="site-footer-rich__brand-mark" src="/brand/x-logo.svg" width="17" height="17" alt="" aria-hidden="true" />
            </a>
            <button class="site-footer-rich__chip" type="button" data-footer-wechat aria-haspopup="dialog" aria-controls="footer-wechat-dialog" aria-label={localized('打开微信二维码', 'Open WeChat QR code')} data-aria-zh="打开微信二维码" data-aria-en="Open WeChat QR code">
              <img class="site-footer-rich__brand-mark" src="/brand/wechat-logo.svg" width="22" height="18" alt="" aria-hidden="true" />
            </button>
            <a class="site-footer-rich__chip" href={`mailto:${email}`} aria-label={localized('发送邮件', 'Send email')} data-aria-zh="发送邮件" data-aria-en="Send email">
              <Icon name="contact-email" role="control" />
            </a>
          </div>
        </div>
        <nav class="site-footer-rich__columns" aria-label={localized('页脚导航', 'Footer navigation')} data-aria-zh="页脚导航" data-aria-en="Footer navigation">
          {primaryNavigation.map((section) => (
            <div>
              <h2 class="site-footer-rich__heading"><a href={localizedRoute(section.href)}><LocalizedText {...section.label} /></a></h2>
              <ul class="site-footer-rich__list">
                {section.menu.slice(0, maxItemsPerColumn).map((item) => (
                  <li><a href={localizedRoute(item.href)}><LocalizedText {...item.label} /></a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      <div class="site-footer-rich__bottom">
        <span>© {year} Phil Carlos · rzcthink</span>
        <div class="site-footer-rich__tools">
          <a href={siteRoutes.rss}><Icon name="footer-feed" role="meta" />RSS</a>
          <a href={siteRoutes.llms}><Icon name="footer-llms" role="meta" />llms.txt</a>
          <button type="button" data-footer-top><Icon name="footer-top" role="meta" /><LocalizedText zh="回到顶部" en="Back to top" /></button>
        </div>
      </div>
    </div>
    <canvas class="site-footer-rich__ridges" data-footer-ridges aria-hidden="true"></canvas>
  </footer>
  <dialog id="footer-wechat-dialog" class="site-footer-rich__dialog" aria-label={localized('微信二维码', 'WeChat QR code')} data-aria-zh="微信二维码" data-aria-en="WeChat QR code">
    <img src="/uploads/home/wechat-qr.jpg" width="820" height="820" loading="lazy" alt={localized('阿哲的微信二维码', "Phil's WeChat QR code")} data-alt-zh="阿哲的微信二维码" data-alt-en="Phil's WeChat QR code" />
  </dialog>
  <script is:inline src="/scripts/footer-ridges.js"></script>
) : (
  <footer class:list={[variant === 'catalog' ? 'catalog-footer' : 'site-footer', { 'site-footer--home': variant === 'site' }]} data-site-reveal>
    <span>© {year} Phil Carlos · rzcthink</span>
  </footer>
)}

<style>
  .site-footer-rich { position: relative; z-index: 1; margin-top: clamp(40px, 6vw, 88px); border-top: 1px solid var(--hairline); color: var(--muted); font-size: var(--text-2xs); }
  .site-footer-rich__inner { width: min(calc(100% - 48px), 1180px); margin: 0 auto; padding-top: clamp(28px, 5vw, 52px); }
  .site-footer-rich__top { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(0, 2.3fr); gap: 36px clamp(32px, 5vw, 64px); }
  .site-footer-rich__name { margin: 0; color: var(--ink); font-size: 1.375rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
  .site-footer-rich__name a { color: inherit; text-decoration: none; }
    .site-footer-rich__tag { max-width: 28ch; margin: 10px 0 0; font-size: .875rem; line-height: 1.6; }
  .site-footer-rich__contact { display: flex; gap: 4px; margin: 14px 0 0 -10px; }
  .site-footer-rich__chip { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; color: var(--muted); background: transparent; cursor: pointer; transition: color 180ms ease, transform 180ms var(--ease-out); }
  .site-footer-rich__chip:hover, .site-footer-rich__chip:focus-visible { color: var(--ink); transform: translateY(-2px); }
  .site-footer-rich__brand-mark { display: block; object-fit: contain; filter: brightness(0); opacity: .66; transition: opacity 180ms ease; }
  .site-footer-rich__chip:hover .site-footer-rich__brand-mark, .site-footer-rich__chip:focus-visible .site-footer-rich__brand-mark { opacity: 1; }
  :global(:root[data-theme='dark']) .site-footer-rich__brand-mark { filter: none; }
  .site-footer-rich__columns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 24px; }
  .site-footer-rich__heading { margin: 0 0 14px; font-family: var(--font-mono); font-size: .6875rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .site-footer-rich__heading a { color: inherit; text-decoration: none; transition: color 160ms ease; }
  .site-footer-rich__heading a:hover, .site-footer-rich__heading a:focus-visible { color: var(--ink); }
  .site-footer-rich__list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .site-footer-rich__list a { display: inline-block; color: var(--muted); font-size: .8125rem; line-height: 1.5; text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: color 160ms ease, background-size 220ms ease; }
  .site-footer-rich__list a:hover, .site-footer-rich__list a:focus-visible { color: var(--ink); background-size: 100% 1px; }
  .site-footer-rich__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 24px; margin-top: clamp(28px, 4vw, 44px); padding-bottom: 14px; }
  .site-footer-rich__tools { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; margin-right: -10px; }
  .site-footer-rich__tools a, .site-footer-rich__tools button { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 10px; border: 0; border-radius: 999px; color: var(--muted); background: transparent; font: inherit; text-decoration: none; cursor: pointer; transition: color 160ms ease; }
  .site-footer-rich__tools a:hover, .site-footer-rich__tools button:hover, .site-footer-rich__tools a:focus-visible, .site-footer-rich__tools button:focus-visible { color: var(--ink); }
  .site-footer-rich__ridges { display: block; width: 100%; aspect-ratio: 4.4 / 1; min-height: 190px; max-height: 330px; }
  .site-footer-rich__dialog { position: fixed; inset: 0; width: min(360px, calc(100vw - 40px), calc(100dvh - 80px)); max-width: none; max-height: none; margin: auto; padding: 0; overflow: visible; border: 0; border-radius: 8px; background: transparent; box-shadow: 0 18px 70px rgb(0 0 0 / .16); }
  .site-footer-rich__dialog::backdrop { background: rgb(0 0 0 / .3); backdrop-filter: blur(5px); }
  .site-footer-rich__dialog img { display: block; width: 100%; height: auto; border-radius: 8px; background: white; }
  @media (max-width: 860px) {
    .site-footer-rich__top { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .site-footer-rich__inner { width: min(calc(100% - 32px), 1180px); }
    .site-footer-rich__columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer-rich__ridges { aspect-ratio: 2.6 / 1; min-height: 170px; }
  }
  /* Touch: every link gets a finger-sized row; the stack keeps its rhythm because the gaps go to the rows. */
  @media (max-width: 820px), (pointer: coarse) {
    .site-footer-rich__heading { margin-bottom: 4px; }
    .site-footer-rich__heading a { display: inline-flex; min-height: 40px; align-items: center; }
    .site-footer-rich__list { gap: 0; }
    .site-footer-rich__list a { display: inline-flex; min-height: 40px; align-items: center; background-position: 0 calc(100% - 9px); }
    .site-footer-rich__tools a, .site-footer-rich__tools button { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer-rich__chip, .site-footer-rich__list a, .site-footer-rich__brand-mark { transition: none; }
  }
</style>
