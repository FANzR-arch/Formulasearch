---
import LocalizedText from './LocalizedText.astro'
import { getLocalizedRoute, siteRoutes } from '../data/site-routes'
import { uiCopy } from '../data/ui-copy'
import type { Locale } from '../lib/i18n'

interface Props {
  locale?: Locale
  showHomeLink?: boolean
  variant?: 'catalog' | 'site'
}

const { locale = 'zh', showHomeLink = true, variant = 'site' } = Astro.props
---

<footer class:list={[variant === 'catalog' ? 'catalog-footer' : 'site-footer', { 'site-footer--home': variant === 'site' && !showHomeLink }]} data-site-reveal>
  <span>© {new Date().getFullYear()} Phil Carlos · rzcthink</span>
  {showHomeLink && <a href={getLocalizedRoute(siteRoutes.home, locale)}><LocalizedText {...uiCopy.common.returnHome} /></a>}
</footer>
