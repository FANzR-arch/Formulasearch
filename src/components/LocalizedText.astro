---
import type { LocalizedCopy } from '../lib/i18n'

interface Props {
  en: LocalizedCopy['en']
  zh: LocalizedCopy['zh']
}

const { en, zh } = Astro.props
---

<span class="localized-text"><span class="localized-text__zh" lang="zh-Hans">{zh}</span><span class="localized-text__en" lang="en">{en}</span></span>
