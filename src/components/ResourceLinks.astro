---
import LocalizedText from './LocalizedText.astro'
import Icon from './icon-system/Icon.astro'
import ResourceImage from './ResourceImage.astro'
import type { ResourceLinkSection } from '../data/catalog'
import { getBlogPosts, getPrimaryBlogLink } from '../lib/blog-content'
import { getLocalizedRoute, siteRoutes } from '../data/site-routes'
import type { Locale } from '../lib/i18n'

interface Props {
  section: ResourceLinkSection
  index: number
  locale?: Locale
}

const { section, index, locale = 'zh' } = Astro.props
const postsBySlug = new Map((await getBlogPosts()).map((post) => [post.slug, post]))
const groups = section.groups.filter((group) => group.items.length > 0).map((group) => ({
  ...group,
  items: group.items.map((item) => {
    const post = item.related?.post ? postsBySlug.get(item.related.post) : undefined
    if (item.related?.post && !post) throw new Error(`Resource "${item.id}" references unknown or draft blog post "${item.related.post}".`)
    const href = getLocalizedRoute(item.url ?? getPrimaryBlogLink(post!), locale)
    const relatedLinks = [
      ...(item.related?.skill ? [{ href: getLocalizedRoute(`${siteRoutes.skills}#${item.related.skill}`, locale), icon: 'resources-related-skill' as const, label: { zh: '配套 Skill', en: 'Companion Skill' } }] : []),
      ...(post ? [{ href: getLocalizedRoute(getPrimaryBlogLink(post), locale), icon: 'resources-related-article' as const, label: { zh: '相关文章', en: 'Related article' } }] : []),
      ...(item.related?.project ? [{ href: `${getLocalizedRoute(siteRoutes.projects, locale)}/${item.related.project}`, icon: 'resources-related-project' as const, label: { zh: '项目案例', en: 'Project case' } }] : []),
    ]
    const badge = item.status === 'beta' ? { zh: '测试中', en: 'Beta' } : item.tag
    return { ...item, href, relatedLinks, post, badge }
  }),
}))
const isExternal = (href: string) => /^https?:\/\//i.test(href)
---

{groups.length > 0 && (
  <section id={section.id} class:list={['project-group', 'resource-links', { 'resource-links--tools': section.id === 'tools' }]} data-site-reveal data-site-reveal-delay={String((index % 2) * 70)}>
    <header class="project-group__heading">
      <h2><LocalizedText {...section.title} /></h2>
    </header>
    {groups.map((group) => (
      <section id={`resource-group-${section.id}-${group.id}`} class="resource-links__group" data-resource-group={group.id} aria-labelledby={`resource-group-${section.id}-${group.id}-title`}>
        <header class="resource-links__group-heading">
          <Icon name={group.icon} role="control" />
          <h3 id={`resource-group-${section.id}-${group.id}-title`}><LocalizedText {...group.title} /></h3>
        </header>
        <div class="resource-links__grid">
          {group.items.map((item) => (
            <article id={`resource-${item.id}`} class="resource-card" data-resource-source={item.source}>
              <a class="resource-card__primary" href={item.href} title={item[locale]} data-title-zh={item.zh} data-title-en={item.en} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
                <span class="resource-card__media">
                  <ResourceImage item={item} post={item.post} locale={locale} sizes={section.id === 'tools' ? '(max-width: 560px) calc((100vw - 78px) / 2), (max-width: 820px) calc((100vw - 110px) / 3), 270px' : '(max-width: 820px) calc(100vw - 72px), (max-width: 1280px) calc((100vw - 110px) / 2), 560px'} />
                  {isExternal(item.href) && <Icon class="resource-card__external" name="catalog-external" role="meta" />}
                </span>
                <h4 class="resource-card__title"><LocalizedText zh={item.zh} en={item.en} /></h4>
                {item.badge && <span class="resource-card__tag"><LocalizedText zh={Array.from(item.badge.zh).slice(0, 8).join('')} en={item.badge.en} /></span>}
              </a>
              {item.relatedLinks.length > 0 && (
                <nav class="resource-card__related" aria-label={locale === 'zh' ? `${item.zh}相关链接` : `Links for ${item.en}`} data-aria-zh={`${item.zh}相关链接`} data-aria-en={`Links for ${item.en}`}>
                  {item.relatedLinks.map((link) => (
                    <a href={link.href} title={link.label[locale]} aria-label={link.label[locale]} data-title-zh={link.label.zh} data-title-en={link.label.en} data-aria-zh={link.label.zh} data-aria-en={link.label.en} target={isExternal(link.href) ? '_blank' : undefined} rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}>
                      <Icon name={link.icon} role="control" />
                    </a>
                  ))}
                </nav>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
)}
