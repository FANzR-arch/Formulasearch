---
import BlogCover from './BlogCover.astro'
import BlogPostRow from './BlogPostRow.astro'
import BlogSectionNav from './BlogSectionNav.astro'
import LocalizedText from './LocalizedText.astro'
import HeroMotion from './HeroMotion.astro'
import type { Locale } from '../lib/i18n'
import { formatBlogDate, getBlogPosts, getPrimaryBlogLink, isLocalBlogPost } from '../lib/blog-content'
import { uiCopy } from '../data/ui-copy'
import { blogSectionNavigation, type BlogSectionId } from '../data/blog-navigation'
import { getBlogCategory } from '../data/blog-categories'
import Icon from './icon-system/Icon.astro'

interface Props {
  active?: BlogSectionId
  locale?: Locale
}

const { active = 'all', locale = 'zh' } = Astro.props
const allPosts = await getBlogPosts()
const activeSection = blogSectionNavigation.items.find((item) => item.id === active)
if (!activeSection) throw new Error(`Unknown blog section "${active}".`)
const posts = activeSection.categoryIds.length
  ? allPosts.filter((post) => activeSection.categoryIds.includes(post.categoryId))
  : allPosts
const stagePosts = posts.slice(0, 1)
const stageSlugs = new Set(stagePosts.map((post) => post.slug))
const recentPosts = posts.filter((post) => !stageSlugs.has(post.slug))
const showSourceLanguageNotice = posts.some((post) => post.contentLanguage !== 'en')
const activePost = stagePosts[0]
const primaryLink = (post: (typeof posts)[number]) => getPrimaryBlogLink(post)
const activeCategory = activePost ? getBlogCategory(activePost.categoryId) : undefined
---

<header class="page-hero page-hero--motion blog-hero blog-hero--journal" data-hero-motion="blog" data-reveal>
  <HeroMotion variant="blog" />
  <h1><LocalizedText {...uiCopy.blog.blog} /></h1>
  <p class="page-hero__description blog-hero__intro"><LocalizedText {...uiCopy.blog.heroIntro} /></p>
</header>

<BlogSectionNav active={active} locale={locale} showSourceLanguageNotice={showSourceLanguageNotice} />

{activePost && (
  <section class="cover-stage" data-cover-stage aria-labelledby="stage-title" data-reveal>
    <div class="cover-stage__viewport">
      {stagePosts.map((post, index) => {
        const isLocal = isLocalBlogPost(post)
        return (
          <a
            class:list={['cover-stage__slide', { 'is-active': index === 0 }]}
            href={primaryLink(post)}
            target={isLocal ? undefined : '_blank'}
            rel={isLocal ? undefined : 'noopener noreferrer'}
            data-cover-slide={index}
            aria-hidden={index === 0 ? undefined : 'true'}
            tabindex={index === 0 ? undefined : '-1'}
          >
            {post.cover && <BlogCover src={post.cover} alt={post.coverAlt} altEn={post.coverAltEn} locale={locale} fetchpriority={index === 0 ? 'high' : 'low'} loading={index === 0 ? 'eager' : 'lazy'} sizes="(max-width: 820px) 100vw, 1200px" />}
          </a>
        )
      })}
    </div>

    <div class="cover-stage__details" data-stage-details>
      <p class="post-row__eyebrow">
        <span class="cover-stage__label"><LocalizedText {...uiCopy.blog.featuredIndex} /></span>
        <time class="post-row__meta" datetime={activePost.date} data-stage-date>{formatBlogDate(activePost.date)}</time>
        {activeCategory && <span class="post-row__category"><LocalizedText zh={activeCategory.title} en={activeCategory.titleEn} /></span>}
      </p>
      <h2 id="stage-title">
        <a
          href={primaryLink(activePost)}
          target={isLocalBlogPost(activePost) ? undefined : '_blank'}
          rel={isLocalBlogPost(activePost) ? undefined : 'noopener noreferrer'}
          data-stage-link
          data-stage-title
        ><LocalizedText zh={activePost.title} en={activePost.titleEn ?? activePost.title} enLang={activePost.titleEn ? 'en' : 'zh-Hans'} /></a>
      </h2>
      <p class="cover-stage__summary" data-stage-summary><LocalizedText zh={activePost.summary} en={activePost.summaryEn ?? activePost.summary} enLang={activePost.summaryEn ? 'en' : 'zh-Hans'} /></p>
      <a
        class="cover-stage__more"
        href={primaryLink(activePost)}
        target={isLocalBlogPost(activePost) ? undefined : '_blank'}
        rel={isLocalBlogPost(activePost) ? undefined : 'noopener noreferrer'}
        tabindex="-1"
      ><LocalizedText {...uiCopy.blog.keepReading} /><Icon name="blog-forward" role="meta" /></a>
    </div>

  </section>
)}

<div class="blog-list blog-list--contact-sheet">
  <div class="recent-stream">
    {recentPosts.map((post) => <BlogPostRow post={post} locale={locale} />)}
  </div>
</div>

<script is:inline src="/scripts/blog-index.js"></script>
