---
import { ArrowRight } from '@lucide/astro'
import BlogCover from './BlogCover.astro'
import BlogPostRow from './BlogPostRow.astro'
import BlogSectionNav from './BlogSectionNav.astro'
import LocalizedText from './LocalizedText.astro'
import { blogSettings } from '../data/blog-settings'
import { getLocalizedRoute } from '../data/site-routes'
import { getLocalizedValue, type Locale } from '../lib/i18n'
import { formatBlogDate, getBlogPosts, getPrimaryBlogLink, isLocalBlogPost } from '../lib/blog-content'
import { uiCopy } from '../data/ui-copy'

interface Props {
  locale?: Locale
}

const { locale = 'zh' } = Astro.props
const posts = await getBlogPosts()
const stagePosts = [
  ...posts.filter((post) => post.featured),
  ...posts.filter((post) => !post.featured),
].slice(0, blogSettings.featuredCount)
const stageSlugs = new Set(stagePosts.map((post) => post.slug))
const recentPosts = posts.filter((post) => !stageSlugs.has(post.slug)).slice(0, blogSettings.recentCount)
const activePost = stagePosts[0]
const localizedRoute = (route: string) => getLocalizedRoute(route, locale)
const primaryLink = (post: (typeof posts)[number]) => isLocalBlogPost(post) ? localizedRoute(getPrimaryBlogLink(post)) : getPrimaryBlogLink(post)
const localized = (copy: { zh: string; en: string }) => getLocalizedValue(copy, locale)
---

<header class="blog-hero blog-hero--journal" data-reveal>
  <div class="blog-hero__heading">
    <p class="blog-hero__eyebrow"><LocalizedText {...uiCopy.blog.heroEyebrow} /></p>
    <h1><span><LocalizedText {...uiCopy.blog.blog} /></span></h1>
  </div>
  <p class="blog-hero__intro"><LocalizedText {...uiCopy.blog.heroIntro} /></p>
  <svg class="blog-hero__threads" viewBox="0 0 1180 360" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-20 274C152 338 250 79 413 128s165 207 338 113 243-45 449 30" />
    <path d="M-30 312C168 181 238 307 389 229S628 43 769 132s230 137 451 29" />
    <path d="M-40 88c214 8 252 169 413 146S584 36 747 77s226 207 493 145" />
  </svg>
</header>

<BlogSectionNav active="latest" locale={locale} />

{activePost && (
  <section class="cover-stage" data-cover-stage aria-labelledby="stage-title" data-reveal>
    <div class="cover-stage__viewport">
      {stagePosts.map((post, index) => {
        const isLocal = isLocalBlogPost(post)
        return (
          <a
            class:list={['cover-stage__slide', { 'is-active': index === 0 }]}
            href={primaryLink(post)}
            target={isLocal ? undefined : '_blank'}
            rel={isLocal ? undefined : 'noopener noreferrer'}
            data-cover-slide={index}
            aria-hidden={index === 0 ? undefined : 'true'}
            tabindex={index === 0 ? undefined : '-1'}
          >
            {post.cover && <BlogCover src={post.cover} alt={post.coverAlt} altEn={post.coverAltEn} fetchpriority={index === 0 ? 'high' : 'low'} loading={index === 0 ? 'eager' : 'lazy'} sizes="(max-width: 820px) 100vw, 70vw" />}
          </a>
        )
      })}
      <div class="cover-stage__chrome" aria-hidden="true">
        <span><LocalizedText {...uiCopy.blog.featuredIndex} /></span>
        <span data-stage-count>01 / {String(stagePosts.length).padStart(2, '0')}</span>
      </div>
    </div>

    <div class="cover-stage__details" data-stage-details>
      <p class="post-row__meta">
        <span data-stage-category><LocalizedText zh={activePost.category.title} en={activePost.category.titleEn} /></span>
        <span aria-hidden="true">·</span>
        <span data-stage-date>{formatBlogDate(activePost.date)}</span>
      </p>
      <h2 id="stage-title">
        <a
          href={primaryLink(activePost)}
          target={isLocalBlogPost(activePost) ? undefined : '_blank'}
          rel={isLocalBlogPost(activePost) ? undefined : 'noopener noreferrer'}
          data-stage-link
          data-stage-title
        ><LocalizedText zh={activePost.title} en={activePost.titleEn ?? activePost.title} enLang={activePost.titleEn ? 'en' : 'zh-Hans'} /></a>
      </h2>
      <p class="cover-stage__summary" data-stage-summary><LocalizedText zh={activePost.summary} en={activePost.summaryEn ?? activePost.summary} enLang={activePost.summaryEn ? 'en' : 'zh-Hans'} /></p>
    </div>

    <nav class="cover-stage__index" aria-label={localized(uiCopy.blog.featuredArticles)} data-aria-en={uiCopy.blog.featuredArticles.en} data-aria-zh={uiCopy.blog.featuredArticles.zh}>
      {stagePosts.map((post, index) => (
        <a
          class:list={{ 'is-active': index === 0 }}
          href={primaryLink(post)}
          target={isLocalBlogPost(post) ? undefined : '_blank'}
          rel={isLocalBlogPost(post) ? undefined : 'noopener noreferrer'}
          aria-current={index === 0 ? 'true' : undefined}
          data-stage-trigger={index}
          data-stage-title-zh={post.title}
          data-stage-title-en={post.titleEn ?? post.title}
          data-stage-title-translated={String(Boolean(post.titleEn))}
          data-stage-summary-zh={post.summary}
          data-stage-summary-en={post.summaryEn ?? post.summary}
          data-stage-summary-translated={String(Boolean(post.summaryEn))}
          data-stage-category-zh={post.category.title}
          data-stage-category-en={post.category.titleEn}
          data-stage-date={formatBlogDate(post.date)}
          data-stage-href={primaryLink(post)}
          data-stage-external={String(!isLocalBlogPost(post))}
          data-stage-featured={String(post.featured)}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong><LocalizedText zh={post.title} en={post.titleEn ?? post.title} enLang={post.titleEn ? 'en' : 'zh-Hans'} /></strong>
          <small><LocalizedText zh={post.category.title} en={post.category.titleEn} /></small>
        </a>
      ))}
    </nav>
  </section>
)}

<section class="blog-list blog-list--contact-sheet" aria-labelledby="recent-title" data-reveal>
  <div class="section-heading section-heading--indexed">
    <h2 id="recent-title"><LocalizedText {...uiCopy.blog.recentArticles} /></h2>
    <span><LocalizedText zh={`${String(recentPosts.length).padStart(2, '0')} ${uiCopy.blog.recentCountSuffix.zh}`} en={`${String(recentPosts.length).padStart(2, '0')} ${uiCopy.blog.recentCountSuffix.en}`} /></span>
  </div>
  <div class="recent-stream">
    {recentPosts.map((post) => <BlogPostRow post={post} locale={locale} />)}
  </div>
</section>

<a class="archive-cta" href={localizedRoute('/blog/archive')} data-reveal>
  <span><LocalizedText {...uiCopy.blog.allArticles} /></span>
  <ArrowRight aria-hidden="true" size={16} stroke-width={1.7} />
</a>

<script is:inline src="/scripts/blog-index.js"></script>
