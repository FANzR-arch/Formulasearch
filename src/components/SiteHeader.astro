---
import { primaryNavigation, type PrimarySection } from '../data/navigation'
import { siteConfig } from '../data/site-config'
import { getLocalizedRoute, siteRoutes } from '../data/site-routes'
import { uiCopy } from '../data/ui-copy'
import { getLocalizedValue, interpolateLocalizedCopy, type Locale } from '../lib/i18n'
import GlassSurface from './GlassSurface.astro'
import Icon from './icon-system/Icon.astro'
import LocalizedText from './LocalizedText.astro'

interface Props {
  active?: PrimarySection | 'photos' | 'architecture' | 'partners'
  locale?: Locale
  logoMode?: 'background' | 'home'
}

const { active, locale = 'zh', logoMode = 'home' } = Astro.props
const localizedRoute = (route: string) => getLocalizedRoute(route, locale)
const localized = (copy: { zh: string; en: string }) => getLocalizedValue(copy, locale)
const githubProfileLabel = interpolateLocalizedCopy(uiCopy.navigation.githubProfile, {
  name: { zh: siteConfig.author.name, en: siteConfig.author.name },
})

---

<header class="site-header" aria-label={localized(uiCopy.navigation.primary)} data-aria-en={uiCopy.navigation.primary.en} data-aria-zh={uiCopy.navigation.primary.zh} data-site-reveal>
  <GlassSurface id="site-nav" className="site-header__glass" width="100%" height="100%" borderRadius={999} borderWidth={0.08} brightness={58} opacity={0.86} blur={14} backgroundOpacity={0.16} saturation={1.28} displace={0} distortionScale={-14} redOffset={0} greenOffset={1} blueOffset={2} mixBlendMode="difference" useSvgFilter={false} ariaHidden />
  {logoMode === 'background' ? (
    <button id="background-cycle" class="monogram" type="button" aria-label={localized(uiCopy.navigation.backgroundEffect)} data-aria-en={uiCopy.navigation.backgroundEffect.en} data-aria-zh={uiCopy.navigation.backgroundEffect.zh} title={localized(uiCopy.navigation.backgroundEffect)} data-title-en={uiCopy.navigation.backgroundEffect.en} data-title-zh={uiCopy.navigation.backgroundEffect.zh}
      data-sound="switch" data-sound-volume="0.22"
      data-background-cycle-zh={uiCopy.navigation.backgroundCycle.zh} data-background-cycle-en={uiCopy.navigation.backgroundCycle.en}
      data-background-names={encodeURIComponent(JSON.stringify(uiCopy.navigation.backgroundVariants))}>
      <img src="/brand/logo.svg" alt="" aria-hidden="true" />
    </button>
  ) : (
    <a class="monogram" href={localizedRoute(siteRoutes.home)} aria-label={localized(uiCopy.common.returnHome)} data-aria-en={uiCopy.common.returnHome.en} data-aria-zh={uiCopy.common.returnHome.zh} title={localized(uiCopy.common.returnHome)} data-title-en={uiCopy.common.returnHome.en} data-title-zh={uiCopy.common.returnHome.zh}>
      <img src="/brand/logo.svg" alt="" aria-hidden="true" />
    </a>
  )}

  <button id="mobile-navigation-toggle" class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label={localized(uiCopy.navigation.openNavigation)} data-nav-open-zh={uiCopy.navigation.openNavigation.zh} data-nav-open-en={uiCopy.navigation.openNavigation.en} data-nav-close-zh={uiCopy.navigation.closeNavigation.zh} data-nav-close-en={uiCopy.navigation.closeNavigation.en} data-sound="switch" data-sound-volume="0.18">
    <Icon name="nav-menu" role="control" class="mobile-nav-toggle__menu" />
    <Icon name="nav-close" role="control" class="mobile-nav-toggle__close" />
  </button>

  <nav id="site-navigation" class="site-nav" aria-label={localized(uiCopy.navigation.site)} data-aria-en={uiCopy.navigation.site.en} data-aria-zh={uiCopy.navigation.site.zh}>
    {primaryNavigation.map((section) => (
      section.menu.length > 0 ? <div class="nav-menu">
        <div class="nav-menu__trigger">
          <a class:list={['nav-link', { 'is-active': active === section.id }]} href={localizedRoute(section.href)} aria-current={active === section.id ? 'page' : undefined}><LocalizedText {...section.label} /></a>
          <button class="nav-disclosure" type="button" aria-haspopup="true" aria-expanded="false" aria-controls={`nav-panel-${section.id}`} aria-label={localized(interpolateLocalizedCopy(uiCopy.navigation.openSection, { label: section.label }))} data-nav-open-zh={interpolateLocalizedCopy(uiCopy.navigation.openSection, { label: section.label }).zh} data-nav-open-en={interpolateLocalizedCopy(uiCopy.navigation.openSection, { label: section.label }).en} data-nav-close-zh={interpolateLocalizedCopy(uiCopy.navigation.closeSection, { label: section.label }).zh} data-nav-close-en={interpolateLocalizedCopy(uiCopy.navigation.closeSection, { label: section.label }).en} data-sound="switch" data-sound-volume="0.16">
            <Icon name="nav-chevron" role="control" />
          </button>
        </div>
        <div id={`nav-panel-${section.id}`} class="nav-popover" role="group" aria-label={localized(interpolateLocalizedCopy(uiCopy.navigation.sectionMenu, { label: section.label }))} data-aria-en={interpolateLocalizedCopy(uiCopy.navigation.sectionMenu, { label: section.label }).en} data-aria-zh={interpolateLocalizedCopy(uiCopy.navigation.sectionMenu, { label: section.label }).zh} inert>
          {section.menu.map((item, index) => (
            <a href={localizedRoute(item.href)}>
              <small>{String(index + 1).padStart(2, '0')}</small>
              <span><LocalizedText {...item.label} /></span>
            </a>
          ))}
        </div>
      </div> : <a class:list={['nav-link', { 'is-active': active === section.id }]} href={localizedRoute(section.href)} aria-current={active === section.id ? 'page' : undefined}><LocalizedText {...section.label} /></a>
    ))}
    <div class="nav-utilities">
      <a class:list={['icon-link', 'icon-link--ui', 'icon-link--archive', { 'is-active': active === 'photos' }]} href={localizedRoute(siteRoutes.photos)} aria-current={active === 'photos' ? 'page' : undefined} aria-label={localized(uiCopy.navigation.photos)} data-aria-en={uiCopy.navigation.photos.en} data-aria-zh={uiCopy.navigation.photos.zh} title={localized(uiCopy.navigation.photos)} data-title-en={uiCopy.navigation.photos.en} data-title-zh={uiCopy.navigation.photos.zh}>
        <Icon name="nav-photos" role="control" />
      </a>
      <a class:list={['icon-link', 'icon-link--ui', 'icon-link--archive', { 'is-active': active === 'architecture' }]} href={localizedRoute(siteRoutes.architecture)} aria-current={active === 'architecture' ? 'page' : undefined} aria-label={localized(uiCopy.navigation.architecture)} data-aria-en={uiCopy.navigation.architecture.en} data-aria-zh={uiCopy.navigation.architecture.zh} title={localized(uiCopy.navigation.architecture)} data-title-en={uiCopy.navigation.architecture.en} data-title-zh={uiCopy.navigation.architecture.zh}>
        <Icon name="nav-architecture" role="control" />
      </a>
      <a class:list={['icon-link', 'icon-link--ui', { 'is-active': active === 'partners' }]} href={localizedRoute(siteRoutes.partners)} aria-current={active === 'partners' ? 'page' : undefined} aria-label={localized(uiCopy.navigation.partners)} data-aria-en={uiCopy.navigation.partners.en} data-aria-zh={uiCopy.navigation.partners.zh} title={localized(uiCopy.navigation.partners)} data-title-en={uiCopy.navigation.partners.en} data-title-zh={uiCopy.navigation.partners.zh}>
        <Icon name="nav-partners" role="control" />
      </a>
      <span class="nav-divider nav-divider--social" aria-hidden="true"></span>
      <a class="icon-link icon-link--brand icon-link--github" href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={localized(githubProfileLabel)} data-aria-en={githubProfileLabel.en} data-aria-zh={githubProfileLabel.zh} title={localized(githubProfileLabel)} data-title-en={githubProfileLabel.en} data-title-zh={githubProfileLabel.zh}>
        <img src="/brand/github-mark.svg" alt="" aria-hidden="true" />
      </a>
      <button id="language-toggle" class="language-toggle" type="button" aria-label={localized(locale === 'en' ? uiCopy.navigation.switchToChinese : uiCopy.navigation.switchToEnglish)} title={localized(locale === 'en' ? uiCopy.navigation.switchToChinese : uiCopy.navigation.switchToEnglish)} data-label-en-zh={uiCopy.navigation.switchToEnglish.zh} data-label-en-en={uiCopy.navigation.switchToEnglish.en} data-label-zh-zh={uiCopy.navigation.switchToChinese.zh} data-label-zh-en={uiCopy.navigation.switchToChinese.en} aria-pressed={locale === 'en' ? 'true' : 'false'} data-sound="switch" data-sound-volume="0.2">
        <Icon name="nav-language" role="control" />
      </button>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label={localized(uiCopy.navigation.themeToDark)} data-aria-en={uiCopy.navigation.themeToDark.en} data-aria-zh={uiCopy.navigation.themeToDark.zh} title={localized(uiCopy.navigation.themeToDark)} data-title-en={uiCopy.navigation.themeToDark.en} data-title-zh={uiCopy.navigation.themeToDark.zh} aria-pressed="false" data-sound="switch" data-sound-volume="0.22">
        <Icon name="nav-light" role="control" class="theme-icon__sun" />
        <Icon name="nav-dark" role="control" class="theme-icon__moon" />
      </button>
    </div>
  </nav>
</header>

<script is:inline src="/scripts/site-header.js"></script>
