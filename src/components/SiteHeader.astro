---
interface Props {
  active?: 'blog' | 'projects' | 'skills' | 'lab'
  email: string
  logoMode?: 'background' | 'home'
}

const { active, email, logoMode = 'home' } = Astro.props

const blogMenu = [
  { href: '/blog', label: 'Latest', note: '最近发布' },
  { href: '/blog/series', label: 'Series', note: '按主题阅读' },
  { href: '/blog/archive', label: 'Archive', note: '全部文章' },
]
---

<header class="site-header" aria-label="Primary navigation">
  {logoMode === 'background' ? (
    <button id="background-cycle" class="monogram" type="button" aria-label="切换背景特效" title="切换背景特效">
      <img src="/brand/logo.svg" alt="" aria-hidden="true" />
    </button>
  ) : (
    <a class="monogram" href="/" aria-label="返回首页" title="返回首页">
      <img src="/brand/logo.svg" alt="" aria-hidden="true" />
    </a>
  )}

  <nav class="site-nav" aria-label="网站导航">
    <div class="nav-menu">
      <a class:list={['nav-link', { 'is-active': active === 'blog' }]} href="/blog" aria-haspopup="true">Blog</a>
      <div class="nav-popover" aria-label="Blog 子菜单">
        {blogMenu.map((item) => (
          <a href={item.href}>
            <span>{item.label}</span>
            <small>{item.note}</small>
          </a>
        ))}
      </div>
    </div>
    <span class:list={['nav-link', 'nav-link--pending', { 'is-active': active === 'projects' }]} title="即将开放">Projects</span>
    <span class:list={['nav-link', 'nav-link--pending', { 'is-active': active === 'skills' }]} title="即将开放">Skills</span>
    <span class:list={['nav-link', 'nav-link--pending', { 'is-active': active === 'lab' }]} title="即将开放">Lab</span>
    <span class="nav-divider" aria-hidden="true"></span>
    <a class="icon-link icon-link--brand icon-link--x" href="https://x.com/Formulasearch" target="_blank" rel="noreferrer" aria-label="Carlos Phil on X" title="X">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
      </svg>
    </a>
    <a class="icon-link icon-link--brand icon-link--github" href="https://github.com/FANzR-arch" target="_blank" rel="noreferrer" aria-label="Carlos Phil on GitHub" title="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
      </svg>
    </a>
    <a class="icon-link icon-link--ui icon-link--mail" href={`mailto:${email}`} aria-label="给 Carlos Phil 发邮件" title="Email">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
        <rect x="2" y="4" width="20" height="16" rx="2" />
      </svg>
    </a>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换黑白主题" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path class="theme-icon__sun" d="M12 3v2m0 14v2M3 12h2m14 0h2m-2.64-6.36-1.42 1.42M6.06 17.94l1.42-1.42m0-9.46-1.42-1.42m12.02 12.02-1.42-1.42M15.5 12a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" />
        <path class="theme-icon__moon" d="M18.5 15.32A7.2 7.2 0 0 1 8.68 5.5 7.2 7.2 0 1 0 18.5 15.32Z" />
      </svg>
    </button>
  </nav>
</header>
