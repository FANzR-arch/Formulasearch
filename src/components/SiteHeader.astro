---
import { Aperture, ChevronDown, DraftingCompass, Globe, Menu, Moon, Sun, X } from '@lucide/astro'
import { primaryNavigation, type PrimarySection } from '../data/navigation'
import { siteConfig } from '../data/site-config'
import { uiCopy } from '../data/ui-copy'
import { interpolateLocalizedCopy } from '../lib/i18n'
import LocalizedText from './LocalizedText.astro'

interface Props {
  active?: PrimarySection | 'photos' | 'architecture'
  logoMode?: 'background' | 'home'
}

const { active, logoMode = 'home' } = Astro.props
const githubProfileLabel = interpolateLocalizedCopy(uiCopy.navigation.githubProfile, {
  name: { zh: siteConfig.author.name, en: siteConfig.author.name },
})

---

<header class="site-header" aria-label={uiCopy.navigation.primary.zh} data-aria-en={uiCopy.navigation.primary.en} data-aria-zh={uiCopy.navigation.primary.zh}>
  {logoMode === 'background' ? (
    <button id="background-cycle" class="monogram" type="button" aria-label={uiCopy.navigation.backgroundEffect.zh} data-aria-en={uiCopy.navigation.backgroundEffect.en} data-aria-zh={uiCopy.navigation.backgroundEffect.zh} title={uiCopy.navigation.backgroundEffect.zh} data-title-en={uiCopy.navigation.backgroundEffect.en} data-title-zh={uiCopy.navigation.backgroundEffect.zh}
      data-background-cycle-zh={uiCopy.navigation.backgroundCycle.zh} data-background-cycle-en={uiCopy.navigation.backgroundCycle.en}
      data-background-name-dither-zh={uiCopy.navigation.backgroundVariants.dither.zh} data-background-name-dither-en={uiCopy.navigation.backgroundVariants.dither.en}
      data-background-name-molten-zh={uiCopy.navigation.backgroundVariants.molten.zh} data-background-name-molten-en={uiCopy.navigation.backgroundVariants.molten.en}
      data-background-name-contour-zh={uiCopy.navigation.backgroundVariants.contour.zh} data-background-name-contour-en={uiCopy.navigation.backgroundVariants.contour.en}>
      <img src="/brand/logo.svg" alt="" aria-hidden="true" />
    </button>
  ) : (
    <a class="monogram" href="/" aria-label={uiCopy.common.returnHome.zh} data-aria-en={uiCopy.common.returnHome.en} data-aria-zh={uiCopy.common.returnHome.zh} title={uiCopy.common.returnHome.zh} data-title-en={uiCopy.common.returnHome.en} data-title-zh={uiCopy.common.returnHome.zh}>
      <img src="/brand/logo.svg" alt="" aria-hidden="true" />
    </a>
  )}

  <button id="mobile-navigation-toggle" class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label={uiCopy.navigation.openNavigation.zh} data-aria-en={uiCopy.navigation.openNavigation.en} data-aria-zh={uiCopy.navigation.openNavigation.zh}>
    <Menu class="mobile-nav-toggle__menu" aria-hidden="true" />
    <X class="mobile-nav-toggle__close" aria-hidden="true" />
  </button>

  <nav id="site-navigation" class="site-nav" aria-label={uiCopy.navigation.site.zh} data-aria-en={uiCopy.navigation.site.en} data-aria-zh={uiCopy.navigation.site.zh}>
    {primaryNavigation.map((section) => (
      <div class="nav-menu">
        <div class="nav-menu__trigger">
          <a class:list={['nav-link', { 'is-active': active === section.id }]} href={section.href} aria-current={active === section.id ? 'page' : undefined}><LocalizedText {...section.label} /></a>
          <button class="nav-disclosure" type="button" aria-expanded="false" aria-controls={`nav-panel-${section.id}`} aria-label={interpolateLocalizedCopy(uiCopy.navigation.openSection, { label: section.label }).zh} data-aria-en={interpolateLocalizedCopy(uiCopy.navigation.openSection, { label: section.label }).en} data-aria-zh={interpolateLocalizedCopy(uiCopy.navigation.openSection, { label: section.label }).zh}>
            <ChevronDown aria-hidden="true" />
          </button>
        </div>
        <div id={`nav-panel-${section.id}`} class="nav-popover" aria-label={interpolateLocalizedCopy(uiCopy.navigation.sectionMenu, { label: section.label }).zh} data-aria-en={interpolateLocalizedCopy(uiCopy.navigation.sectionMenu, { label: section.label }).en} data-aria-zh={interpolateLocalizedCopy(uiCopy.navigation.sectionMenu, { label: section.label }).zh} inert>
          {section.menu.map((item, index) => (
            <a href={item.href}>
              <small>{String(index + 1).padStart(2, '0')}</small>
              <span><LocalizedText {...item.label} /></span>
              <em><LocalizedText {...item.note} /></em>
            </a>
          ))}
        </div>
      </div>
    ))}
    <div class="nav-utilities">
      <span class="nav-divider nav-divider--archive" aria-hidden="true"></span>
      <a class:list={['icon-link', 'icon-link--ui', 'icon-link--archive', { 'is-active': active === 'photos' }]} href="/photos" aria-label={uiCopy.navigation.photos.zh} data-aria-en={uiCopy.navigation.photos.en} data-aria-zh={uiCopy.navigation.photos.zh} title={uiCopy.navigation.photos.zh} data-title-en={uiCopy.navigation.photos.en} data-title-zh={uiCopy.navigation.photos.zh}>
        <Aperture aria-hidden="true" />
      </a>
      <a class:list={['icon-link', 'icon-link--ui', 'icon-link--archive', { 'is-active': active === 'architecture' }]} href="/architecture" aria-label={uiCopy.navigation.architecture.zh} data-aria-en={uiCopy.navigation.architecture.en} data-aria-zh={uiCopy.navigation.architecture.zh} title={uiCopy.navigation.architecture.zh} data-title-en={uiCopy.navigation.architecture.en} data-title-zh={uiCopy.navigation.architecture.zh}>
        <DraftingCompass aria-hidden="true" />
      </a>
      <span class="nav-divider nav-divider--social" aria-hidden="true"></span>
      <a class="icon-link icon-link--brand icon-link--github" href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={githubProfileLabel.zh} data-aria-en={githubProfileLabel.en} data-aria-zh={githubProfileLabel.zh} title={githubProfileLabel.zh} data-title-en={githubProfileLabel.en} data-title-zh={githubProfileLabel.zh}>
        <img src="/brand/github-mark.svg" alt="" aria-hidden="true" />
      </a>
      <button id="language-toggle" class="language-toggle" type="button" aria-label={uiCopy.navigation.switchToEnglish.zh} title={uiCopy.navigation.switchToEnglish.zh} data-label-en-zh={uiCopy.navigation.switchToEnglish.zh} data-label-en-en={uiCopy.navigation.switchToEnglish.en} data-label-zh-zh={uiCopy.navigation.switchToChinese.zh} data-label-zh-en={uiCopy.navigation.switchToChinese.en} aria-pressed="false">
        <Globe aria-hidden="true" />
      </button>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label={uiCopy.navigation.themeToDark.zh} aria-pressed="false">
        <Sun class="theme-icon__sun" aria-hidden="true" />
        <Moon class="theme-icon__moon" aria-hidden="true" />
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  const primaryNavigation = document.querySelector('.site-nav')
  const mobileNavigationToggle = document.querySelector('#mobile-navigation-toggle')
  const languageToggle = document.querySelector('#language-toggle')
  const navMenus = primaryNavigation ? Array.from(primaryNavigation.querySelectorAll('.nav-menu')) : []
  let navCloseTimer

  const closeNavigationMenus = (except) => {
    navMenus.forEach((menu) => {
      if (menu === except) return
      menu.classList.remove('is-open')
      menu.querySelector('.nav-disclosure')?.setAttribute('aria-expanded', 'false')
      menu.querySelector('.nav-popover')?.setAttribute('inert', '')
    })
  }

  const closeMobileNavigation = ({ restoreFocus = false } = {}) => {
    const header = document.querySelector('.site-header')
    const wasOpen = header?.classList.contains('is-nav-open')
    header?.classList.remove('is-nav-open')
    mobileNavigationToggle?.setAttribute('aria-expanded', 'false')
    if (restoreFocus && wasOpen) mobileNavigationToggle?.focus()
  }

  const openNavigationMenu = (menu) => {
    clearTimeout(navCloseTimer)
    closeNavigationMenus(menu)
    menu.classList.add('is-open')
    menu.querySelector('.nav-disclosure')?.setAttribute('aria-expanded', 'true')
    menu.querySelector('.nav-popover')?.removeAttribute('inert')
  }

  navMenus.forEach((menu) => {
    const button = menu.querySelector('.nav-disclosure')
    button?.addEventListener('click', () => {
      if (menu.classList.contains('is-open')) closeNavigationMenus()
      else openNavigationMenu(menu)
    })

    menu.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') openNavigationMenu(menu)
    })
    menu.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return
      navCloseTimer = window.setTimeout(() => closeNavigationMenus(), 180)
    })
    menu.addEventListener('focusin', () => openNavigationMenu(menu))
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      const openButton = primaryNavigation?.querySelector('.nav-disclosure[aria-expanded="true"]')
      const mobileWasOpen = document.querySelector('.site-header')?.classList.contains('is-nav-open')
      closeNavigationMenus()
      closeMobileNavigation({ restoreFocus: mobileWasOpen })
      if (!mobileWasOpen) openButton?.focus()
      return
    }
    if (event.key !== 'Tab' || !document.querySelector('.site-header')?.classList.contains('is-nav-open')) return
    const focusable = [...primaryNavigation.querySelectorAll('a, button')].filter((element) => !element.hasAttribute('disabled') && !element.closest('[inert]') && element.getClientRects().length)
    if (!focusable.length) return
    const first = focusable[0]
    const last = focusable[focusable.length - 1]
    if (event.shiftKey && event.target === first) {
      event.preventDefault()
      last.focus()
    } else if (!event.shiftKey && event.target === last) {
      event.preventDefault()
      first.focus()
    }
  })

  mobileNavigationToggle?.addEventListener('click', () => {
    const isOpen = document.querySelector('.site-header')?.classList.toggle('is-nav-open') ?? false
    mobileNavigationToggle.setAttribute('aria-expanded', String(isOpen))
    if (isOpen) {
      requestAnimationFrame(() => primaryNavigation?.querySelector('a, button')?.focus())
    } else {
      closeNavigationMenus()
    }
  })

  primaryNavigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeMobileNavigation())
  })

  document.addEventListener('pointerdown', (event) => {
    if (primaryNavigation?.contains(event.target)) return
    closeNavigationMenus()
    closeMobileNavigation()
  })

  const updateLanguageToggle = () => {
    const isEnglish = document.documentElement.dataset.locale === 'en'
    languageToggle.setAttribute('aria-pressed', String(isEnglish))
    const labelKey = isEnglish ? 'labelZhEn' : 'labelEnZh'
    languageToggle.setAttribute('aria-label', languageToggle.dataset[labelKey] || '')
    languageToggle.setAttribute('title', languageToggle.dataset[labelKey] || '')
  }

  updateLanguageToggle()
  languageToggle?.addEventListener('click', () => {
    const nextLocale = document.documentElement.dataset.locale === 'en' ? 'zh' : 'en'
    window.formulasearchSetLocale?.(nextLocale)
  })
  window.addEventListener('formulasearch:locale', updateLanguageToggle)
</script>
