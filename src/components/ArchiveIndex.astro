---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import LocalizedText from './LocalizedText.astro'
import { uiCopy } from '../data/ui-copy'

interface ArchiveItem {
  alt: string
  caption: { en: string; zh: string }
  height?: number
  image: ImageMetadata | string
  index: string
  label: { en: string; zh: string }
  layout: 'hero' | 'portrait' | 'landscape' | 'square' | 'wide'
  tags: string[]
  width?: number
}

interface Filter {
  en: string
  id: string
  zh: string
}

interface Props {
  active: 'architecture' | 'photos'
  description: { en: string; zh: string }
  filters: Filter[]
  items: ArchiveItem[]
  kicker: { en: string; zh: string }
  title: { en: string; zh: string }
}

const { active, description, filters, items, kicker, title } = Astro.props
const initialVisibleItems = active === 'photos' ? 8 : items.length
---

<section class:list={['visual-archive', { 'visual-archive--photos': active === 'photos' }]} aria-labelledby="archive-title">
  <header class="visual-archive__intro">
    <p class="visual-archive__kicker"><LocalizedText {...kicker} /></p>
    <h1 id="archive-title"><LocalizedText {...title} /></h1>
    <p class="visual-archive__description"><LocalizedText {...description} /></p>
  </header>

  <div class="visual-archive__utility">
    <nav class="visual-archive__modes" aria-label={uiCopy.archive.sections.zh} data-aria-en={uiCopy.archive.sections.en} data-aria-zh={uiCopy.archive.sections.zh}>
      <a class:list={{ 'is-active': active === 'photos' }} href="/photos"><LocalizedText {...uiCopy.archive.photos} /></a>
      <a class:list={{ 'is-active': active === 'architecture' }} href="/architecture"><LocalizedText {...uiCopy.archive.architecture} /></a>
    </nav>
    {filters.length > 1 && (
      <div class="visual-archive__filters" role="group" aria-label={uiCopy.archive.filters.zh} data-aria-en={uiCopy.archive.filters.en} data-aria-zh={uiCopy.archive.filters.zh}>
        <span><LocalizedText {...uiCopy.archive.browse} /></span>
        {filters.map((filter, index) => (
          <button class:list={{ 'is-active': index === 0 }} type="button" data-archive-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
            <LocalizedText zh={filter.zh} en={filter.en} />
          </button>
        ))}
      </div>
    )}
  </div>

  <div id="archive-grid" class="visual-archive__grid" data-archive-grid>
    {items.map((item, index) => (
      <figure class:list={['archive-record', `archive-record--${item.layout}`]} data-archive-record={item.tags.join(' ')} data-archive-index={index} hidden={index >= initialVisibleItems}>
        {typeof item.image === 'string' ? (
          <img src={item.image} alt={item.alt} data-alt-zh={item.alt} data-alt-en={`${item.label.en} — ${item.caption.en}`} width={item.width} height={item.height} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" sizes="(max-width: 680px) 100vw, (max-width: 1060px) 50vw, 33vw" />
        ) : (
          <Image src={item.image} alt={item.alt} data-alt-zh={item.alt} data-alt-en={`${item.label.en} — ${item.caption.en}`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" sizes="(max-width: 680px) 100vw, (max-width: 1060px) 50vw, 33vw" />
        )}
        <figcaption>
          <span>{item.index}</span>
          <strong><LocalizedText {...item.label} /></strong>
          <em><LocalizedText {...item.caption} /></em>
        </figcaption>
      </figure>
    ))}
  </div>

  <p class="visually-hidden" data-archive-status data-status-zh={uiCopy.archive.results.zh} data-status-en={uiCopy.archive.results.en} role="status" aria-live="polite"></p>

  {items.length > initialVisibleItems && (
    <div class="visual-archive__more">
      <button type="button" data-archive-more aria-controls="archive-grid">
        <LocalizedText {...uiCopy.archive.loadMore} />
      </button>
    </div>
  )}

  <footer class="visual-archive__note">
    <p><LocalizedText {...uiCopy.archive.note} /></p>
    <a href="#archive-title"><LocalizedText {...uiCopy.archive.backToTop} /></a>
  </footer>
</section>

<script>
  const filterButtons = document.querySelectorAll('[data-archive-filter]')
  const archiveRecords = [...document.querySelectorAll('[data-archive-record]')]
  const moreButton = document.querySelector('[data-archive-more]')
  const status = document.querySelector('[data-archive-status]')
  let activeFilter = filterButtons[0]?.getAttribute('data-archive-filter') ?? 'all'
  let visibleCount = archiveRecords.filter((record) => !record.hasAttribute('hidden')).length

  const renderArchive = () => {
    let matchingCount = 0
    let visibleMatchCount = 0
    archiveRecords.forEach((record) => {
      const matches = activeFilter === 'all' || record.getAttribute('data-archive-record')?.split(' ').includes(activeFilter)
      const visible = matches && visibleMatchCount < visibleCount
      if (matches) {
        matchingCount += 1
        if (visible) visibleMatchCount += 1
      }
      record.toggleAttribute('hidden', !visible)
    })
    moreButton?.toggleAttribute('hidden', visibleCount >= matchingCount)
    if (status instanceof HTMLElement) {
      const locale = document.documentElement.dataset.locale === 'en' ? 'en' : 'zh'
      const template = status.dataset[`status${locale === 'en' ? 'En' : 'Zh'}`] || ''
      status.textContent = template.replace('{visible}', String(visibleMatchCount)).replace('{total}', String(matchingCount))
    }
  }

  renderArchive()

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.getAttribute('data-archive-filter') ?? 'all'
      filterButtons.forEach((item) => {
        const selected = item.getAttribute('data-archive-filter') === activeFilter
        item.classList.toggle('is-active', selected)
        item.setAttribute('aria-pressed', String(selected))
      })
      renderArchive()
    })
  })

  moreButton?.addEventListener('click', () => {
    visibleCount = Math.min(archiveRecords.length, visibleCount + 8)
    renderArchive()
  })

  window.addEventListener('formulasearch:locale', renderArchive)
</script>
