---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import LocalizedText from './LocalizedText.astro'

interface ArchiveItem {
  alt: string
  caption: { en: string; zh: string }
  height?: number
  image: ImageMetadata | string
  index: string
  label: { en: string; zh: string }
  layout: 'hero' | 'portrait' | 'landscape' | 'square' | 'wide'
  tags: string[]
  width?: number
}

interface Filter {
  en: string
  id: string
  zh: string
}

interface Props {
  active: 'architecture' | 'photos'
  description: { en: string; zh: string }
  filters: Filter[]
  items: ArchiveItem[]
  kicker: { en: string; zh: string }
  title: { en: string; zh: string }
}

const { active, description, filters, items, kicker, title } = Astro.props
const initialVisibleItems = active === 'photos' ? 8 : items.length
---

<section class:list={['visual-archive', { 'visual-archive--photos': active === 'photos' }]} aria-labelledby="archive-title">
  <header class="visual-archive__intro">
    <p class="visual-archive__kicker"><LocalizedText {...kicker} /></p>
    <h1 id="archive-title"><LocalizedText {...title} /></h1>
    <p class="visual-archive__description"><LocalizedText {...description} /></p>
  </header>

  <div class="visual-archive__utility">
    <nav class="visual-archive__modes" aria-label="档案栏目" data-aria-en="Archive sections" data-aria-zh="档案栏目">
      <a class:list={{ 'is-active': active === 'photos' }} href="/photos"><LocalizedText zh="摄影" en="Photography" /></a>
      <a class:list={{ 'is-active': active === 'architecture' }} href="/architecture"><LocalizedText zh="建筑" en="Architecture" /></a>
    </nav>
    {filters.length > 1 && (
      <div class="visual-archive__filters" aria-label="档案筛选" data-aria-en="Archive filters" data-aria-zh="档案筛选">
        <span><LocalizedText zh="浏览" en="Browse" /></span>
        {filters.map((filter, index) => (
          <button class:list={{ 'is-active': index === 0 }} type="button" data-archive-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
            <LocalizedText zh={filter.zh} en={filter.en} />
          </button>
        ))}
      </div>
    )}
  </div>

  <div id="archive-grid" class="visual-archive__grid" data-archive-grid>
    {items.map((item, index) => (
      <figure class:list={['archive-record', `archive-record--${item.layout}`]} data-archive-record={item.tags.join(' ')} data-archive-index={index} hidden={index >= initialVisibleItems}>
        {typeof item.image === 'string' ? (
          <img src={item.image} alt={item.alt} width={item.width} height={item.height} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" sizes="(max-width: 680px) 100vw, (max-width: 1060px) 50vw, 33vw" />
        ) : (
          <Image src={item.image} alt={item.alt} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" sizes="(max-width: 680px) 100vw, (max-width: 1060px) 50vw, 33vw" />
        )}
        <figcaption>
          <span>{item.index}</span>
          <strong><LocalizedText {...item.label} /></strong>
          <em><LocalizedText {...item.caption} /></em>
        </figcaption>
      </figure>
    ))}
  </div>

  {items.length > initialVisibleItems && (
    <div class="visual-archive__more">
      <button type="button" data-archive-more aria-controls="archive-grid">
        <LocalizedText zh="继续加载影像" en="Load more images" />
      </button>
    </div>
  )}

  <footer class="visual-archive__note">
    <p><LocalizedText zh="持续整理中的公开视觉档案。" en="A public visual archive, continuously edited." /></p>
    <a href="#archive-title"><LocalizedText zh="回到顶部" en="Back to top" /></a>
  </footer>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-archive-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.archiveFilter ?? 'all'
      document.querySelectorAll<HTMLElement>('[data-archive-filter]').forEach((item) => {
        const selected = item.dataset.archiveFilter === filter
        item.classList.toggle('is-active', selected)
        item.setAttribute('aria-pressed', String(selected))
      })
      document.querySelectorAll<HTMLElement>('[data-archive-record]').forEach((record) => {
        const matches = filter === 'all' || record.dataset.archiveRecord?.split(' ').includes(filter)
        record.toggleAttribute('hidden', !matches)
      })
    })
  })

  const moreButton = document.querySelector<HTMLButtonElement>('[data-archive-more]')
  moreButton?.addEventListener('click', () => {
    const hiddenRecords = [...document.querySelectorAll<HTMLElement>('[data-archive-index]')]
      .filter((record) => record.hidden)
    hiddenRecords.slice(0, 8).forEach((record) => record.removeAttribute('hidden'))
    if (hiddenRecords.length <= 8) moreButton.hidden = true
  })
</script>
