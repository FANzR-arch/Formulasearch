---
import Icon from './icon-system/Icon.astro'
import GlassSurface from './GlassSurface.astro'
import { personalAiEndpoint as endpoint } from '../lib/personal-ai-config'
import '../styles/personal-ai.css'
import '../styles/personal-ai-glow.css'
const home = ['/', '/en', '/en/'].includes(Astro.url.pathname)
const Surface = home ? 'section' : 'dialog'
---
{endpoint && <div data-personal-ai data-endpoint={endpoint} data-home={String(home)}>
  {home && <div class="pai-background" aria-hidden="true"><div class="pai-strands"></div></div>}
  <Surface id={home ? 'personal-ai-home' : 'personal-ai-dialog'} class:list={['pai-surface', home ? 'pai-home' : 'pai-dialog border-glow-card']} aria-label="Phil AI" role={home ? "main" : undefined} tabindex={home ? "-1" : undefined} data-lenis-prevent inert={home ? true : undefined}>
    {!home && <>
      <GlassSurface id="personal-ai" className="pai-glass" chromatic={false} width="100%" height="100%" borderRadius={24} borderWidth={0.06} brightness={50} opacity={0.93} blur={10} backgroundOpacity={0.18} saturation={1.2} displace={0.5} distortionScale={-40} ariaHidden />
      <span class="edge-light" aria-hidden="true"></span>
    </>}
    <header class="pai-header">
      <span class="pai-title">Phil AI</span>
      <button type="button" class="pai-close" aria-label={home ? "返回介绍" : "关闭聊天"}><Icon name={home ? 'blog-back' : 'nav-close'} role="control" />{home && <><span class="localized-text__zh">返回介绍</span><span class="localized-text__en">Back to introduction</span></>}</button>
    </header>
    <div class="pai-status" role="status"><span class="pai-status-text"></span><button type="button" class="pai-retry" hidden><span class="localized-text__zh">重试连接</span><span class="localized-text__en">Retry</span></button></div>
    <iframe title="Phil AI" allow="clipboard-write" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1"></iframe>
  </Surface>
</div>}
<script>
  import '../scripts/personal-ai'
</script>
