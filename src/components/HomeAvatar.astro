---
import type { Locale } from '../lib/i18n'
import ThemeImage from './ThemeImage.astro'
import Icon from './icon-system/Icon.astro'
import { personalAiEndpoint } from '../lib/personal-ai-config'
import light from '../../public/uploads/home/profile-light.png'
import dark from '../../public/uploads/home/profile-dark.png'

interface Props {
  locale?: Locale
}

const { locale = 'zh' } = Astro.props
const label = locale === 'en' ? "Phil's profile portrait" : '阿哲的头像'
const Frame = personalAiEndpoint ? 'button' : 'span'
---

<span class="home-avatar" role={personalAiEndpoint ? 'group' : 'img'} aria-label={label} data-ai-avatar={personalAiEndpoint ? '' : undefined} data-aria-en="Phil's profile portrait" data-aria-zh="阿哲的头像">
  <Frame class="home-avatar__frame" type={personalAiEndpoint ? 'button' : undefined} aria-label={personalAiEndpoint ? label : undefined} aria-expanded={personalAiEndpoint ? 'false' : undefined}>
    <ThemeImage class="home-avatar__image" {light} {dark} widths={[160, 400, 600]} sizes="(any-hover: hover) and (any-pointer: fine) 200px, 72px" alt="" eager />
  </Frame>
  {personalAiEndpoint && <span class="pai-invitation"><button type="button" class="pai-avatar-trigger" data-ai-open aria-controls="personal-ai-home" aria-expanded="false" aria-label="和我的 AI 聊聊" data-aria-en="Talk to my AI" data-aria-zh="和我的 AI 聊聊"><Icon name="chat" role="control" /><span class="pai-invitation-label"><span class="localized-text__zh">和我的 AI 聊聊</span><span class="localized-text__en">Talk to my AI</span></span></button></span>}
</span>
