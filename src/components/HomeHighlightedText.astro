---
import type { LocalizedCopy } from '../lib/i18n'
import HomeHighlightPill from './HomeHighlightPill.astro'

interface Props extends LocalizedCopy {
  zhDetails?: Record<string, string>
  enDetails?: Record<string, string>
}

interface Segment {
  text: string
  highlight: boolean
}

const { zh, en, zhDetails = {}, enDetails = {} } = Astro.props

const splitHighlights = (text: string, terms: string[]): Segment[] => {
  const matches = [...new Set(terms)].filter(Boolean).sort((a, b) => b.length - a.length)
  const segments: Segment[] = []
  let cursor = 0
  let plainStart = 0

  while (cursor < text.length) {
    const match = matches.find((term) => text.startsWith(term, cursor))
    if (!match) {
      cursor += 1
      continue
    }

    if (plainStart < cursor) segments.push({ text: text.slice(plainStart, cursor), highlight: false })
    segments.push({ text: match, highlight: true })
    cursor += match.length
    plainStart = cursor
  }

  if (plainStart < text.length) segments.push({ text: text.slice(plainStart), highlight: false })
  return segments.length > 0 ? segments : [{ text, highlight: false }]
}

---

<span class="localized-text">
  <span class="localized-text__zh" lang="zh-Hans">
    {splitHighlights(zh, Object.keys(zhDetails)).map((segment) => segment.highlight ? <HomeHighlightPill label={segment.text} detail={zhDetails[segment.text]} locale="zh" terminal={segment.text === '项目、博客、Skills 与工具'} /> : segment.text)}
  </span>
  <span class="localized-text__en" lang="en">
    {splitHighlights(en, Object.keys(enDetails)).map((segment) => segment.highlight ? <HomeHighlightPill label={segment.text} detail={enDetails[segment.text]} locale="en" terminal={segment.text === 'projects, blog posts, Skills, and tools'} /> : segment.text)}
  </span>
</span>
