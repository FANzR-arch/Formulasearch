---
import LocalizedText from './LocalizedText.astro'
import HeroMotion, { type HeroMotionVariant } from './HeroMotion.astro'

interface Props {
  description: { en: string; zh: string }
  id?: string
  motionVariant?: HeroMotionVariant
  title: { en: string; zh: string }
}

const { description, id, motionVariant, title } = Astro.props
---

<header class:list={['page-hero', { 'page-hero--motion': motionVariant }]} data-hero-motion={motionVariant} data-site-reveal>
  {motionVariant && <HeroMotion variant={motionVariant} />}
  <h1 id={id}><LocalizedText {...title} /></h1>
  <p class="page-hero__description"><LocalizedText {...description} /></p>
</header>
