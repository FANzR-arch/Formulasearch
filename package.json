    "pretest:smoke": "npm run build",
    "test:smoke": "node scripts/run-smoke.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "astro": "^7.2.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lucide/astro": "^1.31.0"
  },
  "registries": {
    "@react-bits": "https://reactbits.dev/r/{name}.json"
